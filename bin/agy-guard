    try:
        here = Path(__file__).resolve()
        for parent in [here.parent.parent, here.parent, Path.cwd()]:
            if (parent / "GLOBAL_RULES.md").exists():
                return parent
    except Exception:
        pass
    return HOME / "Projects" / "sovereign-agent-os"

