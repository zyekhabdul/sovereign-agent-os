def load_canonical_gemini_md():
    for candidate in [REPO_ROOT / "GLOBAL_RULES.md", REPO_ROOT / "templates" / "GEMINI.md"]:
        try:
            if candidate.exists():
                text = candidate.read_text(encoding="utf-8")
                if text.strip():
                    return text
        except Exception:
            pass
    return _FALLBACK_GEMINI_MD

CANONICAL_GEMINI_MD = load_canonical_gemini_md()

SOVEREIGN_REMOTE_RE = re.compile(r"zyekhabdul|aomiqaza")
THIRD_PARTY_RE = re.compile(r"aur\.archlinux\.org|gitlab\.archlinux\.org")

def get_origin_url(repo_path):
    try:
        return subprocess.check_output(
            ["git", "config", "--get", "remote.origin.url"], cwd=repo_path, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        return ""

def is_third_party_upstream(repo_path):
    origin = get_origin_url(repo_path)
    if not origin:
        return False
    if THIRD_PARTY_RE.search(origin):
        return True
    return not SOVEREIGN_REMOTE_RE.search(origin)

def resolve_strictness(repo_path):
    try:
        v = subprocess.check_output(
            ["git", "config", "--get", "sovereign.strictness"], cwd=repo_path, stderr=subprocess.DEVNULL, text=True
        ).strip().lower()
        if v in ("strict", "standard", "passthrough"):
            return v
    except Exception:
        pass
    if is_third_party_upstream(repo_path):
        return "passthrough"
    return "strict"

def get_git_root(cwd=None):
    if cwd is None:
        cwd = Path.cwd()
    try:
        root = subprocess.check_output(
            ["git", "rev-parse", "--show-toplevel"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip()
        return Path(root)
    except Exception:
        return None

def get_git_info(cwd=None):
    if cwd is None:
        cwd = Path.cwd()
    try:
        commit = subprocess.check_output(
            ["git", "rev-parse", "HEAD"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        commit = "non-git"
    
    try:
        branch = subprocess.check_output(
            ["git", "branch", "--show-current"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip()
    except Exception:
        branch = "none"

    try:
        status_lines = subprocess.check_output(
            ["git", "status", "--short"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip().splitlines()
        dirty_count = len(status_lines)
    except Exception:
        dirty_count = 0

    return commit, branch, dirty_count

def resolve_namespace(cwd=None):
    if cwd is None:
        cwd = Path.cwd()
    cwd = Path(cwd).resolve()
    
    git_root = get_git_root(cwd)
    target = git_root if git_root else cwd
    
    # Boundary Guard: Ephemeral / out-of-boundary directories
    str_target = str(target)
    if str_target.startswith("/tmp") or str_target.startswith("/var/tmp") or not str_target.startswith(str(HOME)):
        return None
    
    if target == HOME:
        return "global-workspace"

    # Invariant 1 (Strict CWD Auto-Binding): Direct match against 00-AGY-Memory
    if (MEMORY_DIR / target.name).exists():
        return target.name

    # Invariant 2: Check remote origin repo name if available
    try:
        remote = subprocess.check_output(
            ["git", "config", "--get", "remote.origin.url"], cwd=target, stderr=subprocess.DEVNULL, text=True
        ).strip()
        if remote:
            repo_name = Path(remote).stem.replace(".git", "")
            if (MEMORY_DIR / repo_name).exists():
                return repo_name
    except Exception:
        pass

    return target.name

def cmd_sync_rules(args):
    print("[ AGY-GUARD ] Synchronizing rule files...")
    canonical = load_canonical_gemini_md()
    synced = 0
    for target in RULE_FILES:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(canonical, encoding="utf-8")
        print(f"  [ SYNCED ] -> {target}")
        synced += 1
    print(f"[ SUCCESS ] {synced} rule files synchronized byte-for-byte.")
    
    # Cross-agent parity sync (Claude Code, OpenCode, Codex)
    sync_script = HOME / "scripts" / "sync-agents.sh"
    if not sync_script.exists():
        sync_script = HOME / "Projects" / "sovereign-agent-os" / "scripts" / "sync-agents.sh"
    if sync_script.exists():
        try:
            print("[ AGY-GUARD ] Running cross-agent synchronizer for multi-agent parity...")
            subprocess.run(["bash", str(sync_script)], check=False)
        except Exception as e:
            print(f"  [ WARN ] Could not run sync-agents.sh: {e}")

def cmd_status(args):
    fix_mode = getattr(args, "fix", False)
    header_extra = " (AUTO-FIX MODE)" if fix_mode else ""
    print(f"=== [ AGY-GUARD SYSTEM STATUS v5.2{header_extra} ] ===")
    canonical = load_canonical_gemini_md()

    # 1. Check GEMINI.md sync
    for target in RULE_FILES:
        if not target.exists():
            if fix_mode:
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(canonical, encoding="utf-8")
                print(f"  [ REPAIRED ] {target}")
            else:
                print(f"  [ MISSING ] {target}")
        else:
            content = target.read_text(encoding="utf-8")
            if content.strip() != canonical.strip():
                if fix_mode:
                    target.write_text(canonical, encoding="utf-8")
                    print(f"  [ REPAIRED ] {target}")
                else:
                    print(f"  [ DRIFT ] {target}")
            else:
                print(f"  [ OK ] {target}")
                
    # 2. Check Formal Rule Specifications
    print("\n--- [ FORMAL RULE SPECIFICATIONS ] ---")
    for rdoc in RULE_DOCS:
        status = "[ OK ]" if rdoc.exists() else "[ MISSING ]"
        print(f"  {status} {rdoc.name}")
    
    # 3. Check Obsidian Vault & 200-Line Cap
    print("\n--- [ OBSIDIAN RAG & MEMORY HEALTH ] ---")
    if VAULT_PATH.exists():
        print(f"  [ OK ] Obsidian Vault: {VAULT_PATH}")
        cwd = Path.cwd()
        ns = resolve_namespace(cwd)
        ns_dir = MEMORY_DIR / ns
        if ns_dir.exists():
            for mfile in ns_dir.glob("*.md"):
                lines = len(mfile.read_text(encoding="utf-8", errors="replace").splitlines())
                if lines > 200:
                    print(f"  [ WARNING ] {mfile.name} is {lines} lines (>200 line cap). Split to archive!")
                else:
                    print(f"  [ OK ] {mfile.name} ({lines}/200 lines)")
        else:
            if fix_mode and ns != "global-workspace":
                ns_dir.mkdir(parents=True, exist_ok=True)
                commit, branch, dirty = get_git_info(cwd)
                now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                (ns_dir / "INDEX.md").write_text(f"""# PROJECT INDEX — {ns}

- **Project Name**: `{ns}`
- **Repository Path**: `{cwd}`
- **Git Commit Hash**: `{commit}`
- **Active Branch**: `{branch}`
- **Last Memory Sync**: {now}
""", encoding="utf-8")
                (ns_dir / "CONTEXT.md").write_text(f"""# PROJECT CONTEXT — {ns}

## Overview
Project workspace located at `{cwd}`.

## Technical Stack & Constraints
- **Architecture Standard**: Ponytail YAGNI, 16 Binding Rules compliant.
- **Max Lines Limit**: 200 lines per RAG file.
""", encoding="utf-8")
                (ns_dir / "STATE.md").write_text(f"""# ACTIVE STATE — {ns}

- **Last Checkpoint**: {now}
- **Status**: ACTIVE
- **Git Branch**: `{branch}`
- **Git Commit**: `{commit}`
- **Uncommitted Changes**: {dirty} file(s)

---

## Active Milestone / Task
- **Summary**: Initial project state initialized
- **Checkpoint Context**: Initialized via agy-guard status --fix

## Invariant Checks
- [x] Ponytail / YAGNI Minimalist verified
- [x] Strict No-Emoji compliant
- [x] Git push permission checked (local only)
""", encoding="utf-8")
                (ns_dir / "DECISIONS.md").write_text(f"""# ARCHITECTURAL DECISIONS (ADR) — {ns}

## ADR-001: [ACTIVE] Project Architecture Initialization
- **Date**: {now[:10]}
- **Context**: Project namespace memory initialized.
- **Decision**: Adhere to 4-file memory schema and strict namespace isolation.

## Standard Laws
- **Law 1**: Ponytail / YAGNI - Minimalist code generation, zero unsolicited refactoring.
- **Law 2**: Empirical Verification - Always verify build/test before concluding task.
- **Law 3**: Git Push Guard - Remote push forbidden without explicit human command.
""", encoding="utf-8")
                print(f"  [ REPAIRED ] Scaffolded RFC-RAG-003 4-file memory structure at {ns_dir}")
            else:
                print(f"  [ NOTICE ] Memory namespace not yet initialized for '{ns}'")
    else:
        print(f"  [ WARNING ] Obsidian Vault not found at {VAULT_PATH}")
    
    # 4. Check Dual-File MCP
    print("\n--- [ MCP DISCOVERY HEALTH ] ---")
    cfg1 = CONFIG_DIR / "mcp_config.json"
    cfg2 = CONFIG_DIR / "mcp_config_extended.json"
    print(f"  [{'OK' if cfg1.exists() else 'MISSING'}] Primary: {cfg1}")
    print(f"  [{'OK' if cfg2.exists() else 'MISSING'}] Extended: {cfg2}")
    
    # 5. Git Info & Namespace
    print("\n--- [ ACTIVE WORKSPACE CONTEXT ] ---")
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    ns = resolve_namespace(cwd)
    commit, branch, dirty = get_git_info(cwd)
    print(f"  [ CWD ] {cwd}")
    print(f"  [ GIT ROOT ] {git_root or 'none (non-git)'}")
    print(f"  [ NAMESPACE ] {ns}")
    print(f"  [ GIT ] Branch: {branch} | Commit: {commit[:8]} | Uncommitted Files: {dirty}")
    
    # 6. Git Hooks
    if git_root:
        pre_commit = git_root / ".git" / "hooks" / "pre-commit"
        post_commit = git_root / ".git" / "hooks" / "post-commit"
        pre_push = git_root / ".git" / "hooks" / "pre-push"
        if fix_mode:
            if not pre_commit.exists():
                cmd_install_pre_commit(args)
            if not post_commit.exists():
                cmd_install_hook(args)
            if not pre_push.exists():
                cmd_install_push_guard(args)
            pre_commit = git_root / ".git" / "hooks" / "pre-commit"
            post_commit = git_root / ".git" / "hooks" / "post-commit"
            pre_push = git_root / ".git" / "hooks" / "pre-push"
        print(f"  [{'OK' if pre_commit.exists() else 'NOTICE'}] Anti-Blunder Pre-Commit Hook: {'Active' if pre_commit.exists() else 'Not installed'}")
        print(f"  [{'OK' if post_commit.exists() else 'NOTICE'}] Auto-Checkpoint Hook: {'Active' if post_commit.exists() else 'Not installed'}")
        print(f"  [{'OK' if pre_push.exists() else 'NOTICE'}] Anti-Push Protection Hook: {'Active' if pre_push.exists() else 'Not installed'}")
        
    # 7. Active Skills Count
    active_skills = len([p for p in SKILLS_DIR.iterdir() if p.is_dir()]) if SKILLS_DIR.exists() else 0
    print(f"  [ SKILLS ] Active: {active_skills} skills (Lean context headroom)")
    print("========================================")

def cmd_context(args):
    """Outputs instant high-density project context briefing for AI sessions."""
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    ns = resolve_namespace(cwd)
    commit, branch, dirty = get_git_info(cwd)
    
    print("=== [ INSTANT PROJECT BRIEFING ] ===")
    print(f"  • Project / Namespace : {ns}")
    print(f"  • Git Root Directory  : {git_root or cwd}")
    print(f"  • Active Git Branch   : {branch}")
    print(f"  • Latest Commit Hash  : {commit}")
    print(f"  • Uncommitted Changes : {dirty} file(s)")
    
    # Read Obsidian STATE.md
    state_file = MEMORY_DIR / ns / "STATE.md"
    if state_file.exists():
        print("\n--- [ ACTIVE OBSIDIAN STATE ] ---")
        lines = state_file.read_text(encoding="utf-8").splitlines()
        for line in lines[:15]:
            print(f"  {line}")
    else:
        print(f"\n  [ NOTICE ] No existing STATE.md found in 00-AGY-Memory/{ns}/")
        
    # Read Obsidian DECISIONS.md if present
    dec_file = MEMORY_DIR / ns / "DECISIONS.md"
    if dec_file.exists():
        print("\n--- [ RECORDED ARCHITECTURAL DECISIONS ] ---")
        lines = dec_file.read_text(encoding="utf-8").splitlines()
        for line in lines[:10]:
            print(f"  {line}")
            
    print("\n====================================")

def build_contextual_gotchas(tech, cwd):
    gotchas = [
        f"- **Boundary Confinement**: All code mutations, tooling, and transient files must remain strictly within `{cwd}`. Zero cross-project bleed.",
        "- **Path Resolution**: Never hardcode host absolute usernames (`/home/...`). Use dynamic resolution, relative paths, or `~/`.",
        "- **Empirical Quality Gate**: All modifications must be verified via `agy-guard verify` or local test suite with exit code 0.",
        "- **Git Push Restriction**: Autonomous `git push` is blocked. Push requires explicit human command (`agy-guard push`).",
    ]
    t = tech.lower()
    if "node" in t or "javascript" in t or "typescript" in t:
        gotchas.append("- **Node Runtime & Memory**: Enforce `--max-old-space-size=256` on host daemons to prevent OOM termination. Distinguish ESM (`import`) vs CommonJS (`require`).")
    elif "python" in t:
        gotchas.append("- **Python Environment**: Prefer virtualenv/isolated runtime. Verify syntax via `python3 -m py_compile` and run `pytest` with non-empty pass mandate.")
    elif "rust" in t:
        gotchas.append("- **Rust Cargo Check**: Run `cargo check` before full test suite to catch compiler/borrow-checker errors early.")
    elif "go" in t:
        gotchas.append("- **Golang Vet**: Run `go vet` and format checks before local commit.")
    elif "php" in t:
        gotchas.append("- **PHP Syntax**: Run `php -l` on modified files before commit.")
    elif "shopify" in t:
        gotchas.append("- **Shopify Theme**: Run `shopify theme check` and verify Liquid schema tags before deploy.")
    return "\n".join(gotchas)

def build_enriched_context_content(ns, cwd, tech):
    gotchas = build_contextual_gotchas(tech, cwd)
    return f"""# PROJECT CONTEXT — {ns}

- **Namespace**: `00-AGY-Memory/{ns}/`
- **Repository Boundary**: `{cwd}`
- **Primary Tech Stack**: {tech}
- **Architecture Standard**: Ponytail YAGNI, 16 Binding Rules compliant.
- **Max Lines Limit**: 200 lines per RAG file.

## Overview
Project workspace located at `{cwd}`.

## Technical Stack & Constraints
- **Primary Stack**: {tech}
- **Runtime Environment**: Sovereign Local Host / Decoupled Node
- **Module Boundaries**: All file mutations must be strictly isolated to `{cwd}`.

## Known Gotchas & Environment Traps
{gotchas}
"""

def build_enriched_state_content(ns, cwd, commit, branch, dirty, status, msg, now, audit=None):
    if audit is None:
        audit = {"boundary_ok": True, "no_emoji": True, "sensitive_ok": True, "adr_ok": True, "active_adrs_count": 0}
    
    emoji_box = "x" if audit.get("no_emoji", True) else " "
    boundary_box = "x" if audit.get("boundary_ok", True) else " "
    adr_box = "x" if audit.get("adr_ok", True) else " "
    adr_count = audit.get("active_adrs_count", 0)

    return f"""# ACTIVE STATE — {ns}

- **Namespace**: `00-AGY-Memory/{ns}/`
- **Repository Boundary**: `{cwd}`
- **Last Checkpoint**: {now}
- **Status**: {status}
- **Git Branch**: `{branch}`
- **Git Commit**: `{commit}`
- **Uncommitted Changes**: {dirty} file(s)

---

## Contextual Briefing (Subagent Alignment)
- **SSoT Namespace**: `00-AGY-Memory/{ns}/`
- **Active Workspace**: `{cwd}`
- **Operational Invariant**: Single-stream autonomous execution, zero-speculation, strict no-emoji.
- **Active Traps**: Consult CONTEXT.md (`## Known Gotchas & Environment Traps`) before planning or execution.

## Active Milestone / Task
- **Summary**: {msg}
- **Checkpoint Context**: Logged via `agy-guard checkpoint`

## Invariant Checks & Groundedness Audit
- [x] Ponytail / YAGNI Minimalist verified
- [{emoji_box}] Strict No-Emoji compliant
- [x] Git push permission checked (local only)
- [{boundary_box}] Boundary isolation verified ({cwd})
- [{adr_box}] ADR alignment verified against DECISIONS.md ({adr_count} active ADRs)
"""

def audit_groundedness(cwd, ns, target_dir, strict=False):
    """
    Automated Groundedness Check (Self-RAG):
    Deterministically audits active code changes against CONTEXT.md invariants and DECISIONS.md ADRs.
    Returns dict with check statuses and violation list.
    """
    cwd = Path(cwd).resolve()
    target_dir = Path(target_dir).resolve()
    
    results = {
        "boundary_ok": True,
        "no_emoji": True,
        "sensitive_ok": True,
        "adr_ok": True,
        "context_ok": True,
        "violations": [],
        "warnings": [],
        "active_adrs_count": 0
    }
    
    # 1. Boundary Confinement Check
    changed_files = []
    try:
        status_out = subprocess.check_output(
            ["git", "status", "--porcelain"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip().splitlines()
        for line in status_out:
            if line.strip():
                parts = line.strip().split(None, 1)
                if len(parts) == 2:
                    changed_files.append(parts[1])
    except Exception:
        pass

    for cf in changed_files:
        try:
            full_p = (cwd / cf).resolve()
            if not str(full_p).startswith(str(cwd)):
                results["boundary_ok"] = False
                results["violations"].append(f"Boundary Leakage: File {cf} resolves outside {cwd}")
        except Exception:
            pass

    # 2. Sensitive Surface Guard
    sensitive_keywords = ["auth", "login", "payment", "stripe", "paypal", "migration", "schema", ".env", "docker-compose", ".github", "workflow"]
    sensitive_modified = [cf for cf in changed_files if any(k in cf.lower() for k in sensitive_keywords)]
    if sensitive_modified:
        results["warnings"].append(f"Sensitive Surface Modified: {', '.join(sensitive_modified)}")

    # 3. Strict No-Emoji Check on Diff
    emoji_pattern = re.compile(r"[\U00010000-\U0010ffff\u2600-\u26ff\u2700-\u27bf]")
    raw_diff = ""
    try:
        raw_diff = subprocess.check_output(
            ["git", "diff", "HEAD"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        )
        if not raw_diff:
            raw_diff = subprocess.check_output(
                ["git", "diff"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
            )
    except Exception:
        pass

    if raw_diff:
        for line in raw_diff.splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                if emoji_pattern.search(line):
                    results["no_emoji"] = False
                    results["violations"].append("Strict No-Emoji Violation: Raw unicode emoji detected in git diff additions.")
                    break

    # 4. ADR Invariant Grounding (DECISIONS.md)
    dec_file = target_dir / "DECISIONS.md"
    active_adrs = []
    if dec_file.exists():
        try:
            dec_text = dec_file.read_text(encoding="utf-8")
            for line in dec_text.splitlines():
                if "[ACTIVE]" in line or "ADR-" in line:
                    active_adrs.append(line.strip())
        except Exception:
            pass
    results["active_adrs_count"] = len(active_adrs)

    legacy_user = "/home/fuck" + "admin"
    if raw_diff:
        for line in raw_diff.splitlines():
            if line.startswith("+") and not line.startswith("+++"):
                if legacy_user in line and "legacy_user" not in line and "audit_groundedness" not in line:
                    results["adr_ok"] = False
                    results["violations"].append(f"ADR Invariant Violation: Hardcoded legacy path '{legacy_user}' detected in diff.")
                    break

    # 5. CONTEXT.md Invariant Grounding
    ctx_file = target_dir / "CONTEXT.md"
    if ctx_file.exists():
        try:
            ctx_text = ctx_file.read_text(encoding="utf-8")
            if "Python" in ctx_text and any("package.json" in cf or "package-lock.json" in cf for cf in changed_files):
                results["warnings"].append("Context Drift Warning: package.json modified in a predominantly Python workspace.")
        except Exception:
            pass

    return results

def cmd_groundedness(args):
    """Executes automated Self-RAG groundedness audit against CONTEXT and DECISIONS."""
    cwd = Path.cwd().resolve()
    ns = args.namespace or resolve_namespace(cwd)
    if not ns:
        print("[ ERROR ] Unable to resolve project namespace for current directory.")
        sys.exit(1)
        
    target_dir = MEMORY_DIR / ns
    audit = audit_groundedness(cwd, ns, target_dir, strict=getattr(args, "strict", False))
    print(f"=== [ SELF-RAG GROUNDEDNESS AUDIT: {ns} ] ===")
    print(f"  • Workspace: {cwd}")
    print(f"  • RAG Memory: 00-AGY-Memory/{ns}/")
    print(f"  • Active ADRs: {audit['active_adrs_count']}")
    
    b_status = "[ OK ]" if audit["boundary_ok"] else "[ FAIL ]"
    e_status = "[ OK ]" if audit["no_emoji"] else "[ FAIL ]"
    s_status = "[ OK ]" if audit["sensitive_ok"] and not audit["warnings"] else "[ WARN ]"
    a_status = "[ OK ]" if audit["adr_ok"] else "[ FAIL ]"
    
    print(f"\n--- [ AUDIT RESULTS ] ---")
    print(f"  {b_status} Boundary Confinement: Isolated to {cwd}")
    print(f"  {e_status} Persona Integrity: Strict No-Emoji compliant")
    if audit["warnings"]:
        for w in audit["warnings"]:
            print(f"  {s_status} {w}")
    else:
        print(f"  {s_status} Sensitive Surfaces: Clean")
    print(f"  {a_status} ADR Invariants: Aligned with {audit['active_adrs_count']} active ADRs")

    if audit["violations"]:
        print("\n--- [ CRITICAL GROUNDEDNESS VIOLATIONS ] ---")
        for v in audit["violations"]:
            print(f"  [ VIOLATION ] -> {v}")
        if getattr(args, "strict", False):
            sys.exit(1)
    else:
        print("\n[ PASS ] 1:1 Invariant grounding verified against CONTEXT.md and DECISIONS.md.")
    print("==============================================")

def cmd_checkpoint(args):
    cwd = Path.cwd().resolve()
    str_cwd = str(cwd)
    if str_cwd.startswith("/tmp") or str_cwd.startswith("/var/tmp") or not str_cwd.startswith(str(HOME)):
        print(f"[ SKIP ] agy-guard checkpoint skipped for out-of-boundary directory: {cwd}")
        return

    ns = args.namespace or resolve_namespace(cwd)
    if not ns or ns.startswith("tmp.") or ns == "tmp":
        print(f"[ SKIP ] agy-guard checkpoint skipped for invalid or ephemeral namespace: {ns}")
        return

    if not args.namespace and is_third_party_upstream(cwd) and not (MEMORY_DIR / ns).exists():
        print(f"[ SKIP ] agy-guard checkpoint skipped for third-party upstream without memory (tier=passthrough). Override with -n <namespace>.")
        return

    msg = args.msg or "Task milestone update"
    status = args.status.upper()
    
    target_dir = MEMORY_DIR / ns
    target_dir.mkdir(parents=True, exist_ok=True)
    state_file = target_dir / "STATE.md"
    
    commit, branch, dirty = get_git_info(cwd)
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    # Automated Groundedness Check (Self-RAG)
    audit = None
    if not getattr(args, "skip_groundedness", False):
        audit = audit_groundedness(cwd, ns, target_dir, strict=getattr(args, "strict", False))
        print("--- [ SELF-RAG GROUNDEDNESS AUDIT ] ---")
        b_status = "[ OK ]" if audit["boundary_ok"] else "[ FAIL ]"
        e_status = "[ OK ]" if audit["no_emoji"] else "[ FAIL ]"
        s_status = "[ OK ]" if audit["sensitive_ok"] and not audit["warnings"] else "[ WARN ]"
        a_status = "[ OK ]" if audit["adr_ok"] else "[ FAIL ]"
        print(f"  {b_status} Boundary Confinement ({cwd})")
        print(f"  {e_status} Strict No-Emoji Invariant")
        if audit["warnings"]:
            for w in audit["warnings"]:
                print(f"  {s_status} {w}")
        else:
            print(f"  {s_status} Sensitive Surfaces Clean")
        print(f"  {a_status} ADR Invariant Alignment ({audit['active_adrs_count']} active ADRs)")
        if audit["violations"]:
            for v in audit["violations"]:
                print(f"  [ VIOLATION ] -> {v}")
            if getattr(args, "strict", False):
                print("[ ERROR ] Checkpoint rejected due to groundedness audit failure (--strict).")
                sys.exit(1)
        print("---------------------------------------")

    state_content = build_enriched_state_content(ns, cwd, commit, branch, dirty, status, msg, now, audit)
    state_file.write_text(state_content.strip() + "\n", encoding="utf-8")
    
    # 4-File Governance Invariant (RFC-RAG-003): Ensure companion files exist
    index_file = target_dir / "INDEX.md"
    if not index_file.exists():
        index_content = f"""# PROJECT INDEX — {ns}

- **Namespace**: `00-AGY-Memory/{ns}/`
- **Project Name**: `{ns}`
- **Repository Path**: `{cwd}`
- **Git Commit Hash**: `{commit}`
- **Active Branch**: `{branch}`
- **Last Memory Sync**: {now}
"""
        index_file.write_text(index_content.strip() + "\n", encoding="utf-8")
    else:
        try:
            old_idx = index_file.read_text(encoding="utf-8")
            if "Git Commit Hash" in old_idx:
                new_idx = re.sub(r"(- \*\*(?:Latest )?Git Commit Hash\*\*:\s*).*", rf"\g<1>`{commit}`", old_idx, flags=re.IGNORECASE)
            else:
                new_idx = old_idx.rstrip() + f"\n- **Git Commit Hash**: `{commit}`\n"
            if "Last Memory Sync" in new_idx:
                new_idx = re.sub(r"(- \*\*Last Memory Sync\*\*:\s*).*", rf"\g<1>{now}", new_idx, flags=re.IGNORECASE)
            else:
                new_idx = new_idx.rstrip() + f"\n- **Last Memory Sync**: {now}\n"
            if new_idx != old_idx:
                index_file.write_text(new_idx.strip() + "\n", encoding="utf-8")
        except Exception:
            pass

    ctx_file = target_dir / "CONTEXT.md"
    if not ctx_file.exists():
        tech = "Generic Codebase"
        if (cwd / "package.json").exists():
            tech = "Node.js / JavaScript / TypeScript"
        elif (cwd / "composer.json").exists():
            tech = "PHP / Laravel / Composer"
        elif (cwd / "Cargo.toml").exists():
            tech = "Rust / Cargo"
        elif (cwd / "go.mod").exists():
            tech = "Golang"
        elif (cwd / "requirements.txt").exists() or (cwd / "pyproject.toml").exists():
            tech = "Python"
        elif (cwd / "config.yml").exists() or "theme" in cwd.name.lower():
            tech = "Shopify Liquid Theme"
            
        ctx_content = build_enriched_context_content(ns, cwd, tech)
        ctx_file.write_text(ctx_content.strip() + "\n", encoding="utf-8")

    dec_file = target_dir / "DECISIONS.md"
    if not dec_file.exists():
        dec_content = f"""# ARCHITECTURAL DECISIONS (ADR) — {ns}

## ADR-001: [ACTIVE] Project Architecture Initialization
- **Date**: {now[:10]}
- **Context**: Project namespace memory initialized.
- **Decision**: Adhere to 4-file memory schema and strict namespace isolation.

## Standard Laws
- **Law 1**: Ponytail / YAGNI - Minimalist code generation, zero unsolicited refactoring.
- **Law 2**: Empirical Verification - Always verify build/test before concluding task.
- **Law 3**: Git Push Guard - Remote push forbidden without explicit human command.
"""
        dec_file.write_text(dec_content.strip() + "\n", encoding="utf-8")

    print(f"[ AGY-GUARD ] Checkpoint saved to: {state_file}")
    print(f"  • Namespace: {ns}")
    print(f"  • Commit: {commit[:8]}")
    print(f"  • Status: {status}")
    print(f"  • Message: {msg}")

def cmd_log_warn(args):
    cwd = Path.cwd().resolve()
    str_cwd = str(cwd)
    if str_cwd.startswith("/tmp") or str_cwd.startswith("/var/tmp") or not str_cwd.startswith(str(HOME)):
        print(f"[ SKIP ] agy-guard log-warn skipped for out-of-boundary directory: {cwd}")
        return

    ns = resolve_namespace(cwd)
    if not ns or ns.startswith("tmp.") or ns == "tmp":
        print(f"[ SKIP ] agy-guard log-warn skipped for invalid or ephemeral namespace: {ns}")
        return

    msg = args.msg or "Unclassified harness warning"
    state_file = MEMORY_DIR / ns / "STATE.md"
    if not state_file.exists():
        print(f"[ SKIP ] agy-guard log-warn: no STATE.md for '{ns}' (run checkpoint first)")
        return

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    lines = state_file.read_text(encoding="utf-8").splitlines()
    header = "## Pre-commit Warnings"
    if header in lines:
        idx = lines.index(header)
        head, tail = lines[:idx + 1], lines[idx + 1:]
    else:
        head, tail = lines + ["", header], []

    warn_lines = [l for l in tail if l.startswith("- [")]
    others = [l for l in tail if not l.startswith("- [")]
    warn_lines.append(f"- [{now}] {msg}")
    warn_lines = warn_lines[-20:]
    state_file.write_text("\n".join(head + warn_lines + others).strip() + "\n", encoding="utf-8")
    print(f"[ LOGGED ] Warning recorded in 00-AGY-Memory/{ns}/STATE.md")

POST_COMMIT_SCRIPT = r"""#!/usr/bin/env bash
# Auto-generated by agy-guard global template (Anti-Desync RAG Synchronizer)
export PATH="$HOME/.local/bin:$PATH"

if command -v agy-guard >/dev/null 2>&1; then
    COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null | head -n 1)
    agy-guard checkpoint --msg "Auto-commit: ${COMMIT_MSG:-Updated files}" --status ACTIVE --skip-groundedness >/dev/null 2>&1
else
    # Direct POSIX fallback: Update INDEX.md and STATE.md commit hash
    GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REPO_NAME="$(basename "$GIT_ROOT")"
    COMMIT_HASH="$(git rev-parse HEAD 2>/dev/null || echo "")"
    NOW="$(date '+%Y-%m-%d %H:%M:%S')"
    MEM_DIR="${OBSIDIAN_VAULT_PATH:-$HOME/Documents/Obsidian Vault}/00-AGY-Memory/$REPO_NAME"

    if [ -n "$COMMIT_HASH" ] && [ -d "$MEM_DIR" ]; then
        if [ -f "$MEM_DIR/INDEX.md" ]; then
            sed -i -E "s/(- \*\*(Latest )?Git Commit Hash\*\*:\s*).*/\1\`$COMMIT_HASH\`/" "$MEM_DIR/INDEX.md" 2>/dev/null || true
            sed -i -E "s/(- \*\*Last Memory Sync\*\*:\s*).*/\1$NOW/" "$MEM_DIR/INDEX.md" 2>/dev/null || true
        fi
        if [ -f "$MEM_DIR/STATE.md" ]; then
            sed -i -E "s/(- \*\*Git Commit\*\*:\s*).*/\1\`$COMMIT_HASH\`/" "$MEM_DIR/STATE.md" 2>/dev/null || true
            sed -i -E "s/(- \*\*Last Checkpoint\*\*:\s*).*/\1$NOW/" "$MEM_DIR/STATE.md" 2>/dev/null || true
        fi
    fi
fi
"""

PRE_PUSH_SCRIPT = """#!/usr/bin/env bash
# Hard Push Guard Interceptor by agy-guard
if [ "${ALLOW_GIT_PUSH:-0}" != "1" ]; then
    echo "[ HARD GUARD BLOCKED ] 'git push' is forbidden by default AI Agent policy." >&2
    echo "To push with explicit human intent, run: ALLOW_GIT_PUSH=1 git push" >&2
    exit 1
fi
"""

def cmd_install_hook(args):
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    if not git_root:
        print("[ ERROR ] Current directory is not inside a git repository.", file=sys.stderr)
        sys.exit(1)

    hooks_dir = git_root / ".git" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    post_commit = hooks_dir / "post-commit"

    post_commit.write_text(load_post_commit_script(), encoding="utf-8")
    post_commit.chmod(0o755)
    print(f"[ SUCCESS ] Git post-commit hook successfully installed at: {post_commit}")

def cmd_install_push_guard(args):
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    if not git_root:
        print("[ ERROR ] Current directory is not inside a git repository.", file=sys.stderr)
        sys.exit(1)

    hooks_dir = git_root / ".git" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    pre_push = hooks_dir / "pre-push"

    pre_push.write_text(load_pre_push_script(), encoding="utf-8")
    pre_push.chmod(0o755)
    print(f"[ SUCCESS ] Anti-Push Protection Hook installed at: {pre_push}")
    print("  • Remote push is now physically blocked unless ALLOW_GIT_PUSH=1 is passed.")

PRE_COMMIT_SCRIPT = r"""#!/usr/bin/env bash
# PRE-COMMIT HARNESS: Deterministic Anti-Blunder Sanitizer
# Generated by agy-guard (SSOT: templates/git-hooks/pre-commit)
set -euo pipefail

# 0. Sovereign strictness tier: strict (default) | standard | passthrough
# Explicit override: git config sovereign.strictness <tier>
# Third-party upstream (origin outside sovereign forges) auto-passthrough.
SOVEREIGN_TIER="$(git config --get sovereign.strictness 2>/dev/null || true)"
if [ -z "$SOVEREIGN_TIER" ]; then
    _SOV_ORIGIN="$(git config --get remote.origin.url 2>/dev/null || true)"
    if [ -n "$_SOV_ORIGIN" ] && ! echo "$_SOV_ORIGIN" | grep -Eq 'zyekhabdul|aomiqaza'; then
        SOVEREIGN_TIER="passthrough"
    else
        SOVEREIGN_TIER="strict"
    fi
fi
case "$SOVEREIGN_TIER" in
    strict|standard|passthrough) ;;
    *) SOVEREIGN_TIER="strict" ;;
esac
if [ "$SOVEREIGN_TIER" = "passthrough" ]; then
    echo "[ SKIP ] Sovereign pre-commit harness passthrough for third-party upstream (tier=passthrough)."
    exit 0
fi

# WARN helper for standard tier: print + best-effort log to Obsidian STATE.md
sovereign_warn() {
    echo "[ WARN ] $1" >&2
    if command -v agy-guard >/dev/null 2>&1; then
        agy-guard log-warn --msg "$1" >/dev/null 2>&1 || true
    fi
}

# 1. Block Lazy Truncation Placeholders (Membunuh: // ... existing code ...)
if git rev-parse --verify HEAD >/dev/null 2>&1; then
    if git diff --cached -- . ':!*.md' ':!*pre-commit*' ':!*agy-guard*' | grep -E '^\+[^+]' | grep -Eiq '(existing code|remaining unchanged|TODO: implement|rest of (the|your) code)'; then
        echo "[ HARDBLOCK ] Terdeteksi placeholder kode malas/terpotong di staged diff source code!" >&2
        echo "Contoh terlarang: '// ... existing code ...', 'TODO: implement'" >&2
        exit 1
    fi
fi

# 2. Block Emojis in staged files (Membunuh: Polusi Emoji di Codebase)
if git diff --cached | grep -E '^\+[^+]' | grep -P "[\x{1F600}-\x{1F64F}\x{1F300}-\x{1F5FF}\x{1F680}-\x{1F6FF}\x{2600}-\x{26FF}\x{2700}-\x{27BF}]" 2>/dev/null; then
    echo "[ HARDBLOCK ] Terdeteksi karakter emoji dalam staged files." >&2
    echo "Gunakan ikon SVG/Lucide atau token teks sesuai aturan strict no-emoji." >&2
    exit 1
fi

# 3. Block Test Tampering (Membunuh: Mengubah tes eksisting saat mengerjakan fitur)
if [ "${ALLOW_TEST_MUTATION:-0}" != "1" ]; then
    MODIFIED_TESTS=$(git diff --cached --diff-filter=M --name-only | grep -E '^tests/|^spec/|.*\.test\..*|.*\.spec\..*' || true)
    STAGED_SRC=$(git diff --cached --name-only | grep -vE '^tests/|^spec/|.*\.test\..*|.*\.spec\..*' || true)
    if [ -n "$MODIFIED_TESTS" ] && [ -n "$STAGED_SRC" ]; then
        if [ "$SOVEREIGN_TIER" = "standard" ]; then
            sovereign_warn "Test+source co-modification allowed under standard tier (files: $MODIFIED_TESTS)"
        else
            echo "[ HARDBLOCK ] Memodifikasi file tes eksisting bersamaan dengan source code dilarang." >&2
            echo "Penambahan file tes baru diizinkan. Untuk memodifikasi tes eksisting, jalankan: ALLOW_TEST_MUTATION=1 git commit" >&2
            exit 1
        fi
    fi
fi

# 4. Block Secret & Private Key Leaks
STAGED_SECRETS=$(git diff --cached --name-only | grep -E '(^|/)\.env$|\.pem$|\.key$|id_rsa' || true)
if [ -n "$STAGED_SECRETS" ]; then
    if [ "${ALLOW_SECRET_COMMIT:-0}" != "1" ]; then
        echo "[ HARDBLOCK ] File rahasia/kredensial terdeteksi di staged files: $STAGED_SECRETS" >&2
        echo "Gunakan .env.example atau password manager." >&2
        exit 1
    fi
fi

# 5. Check Required Files on projects in execution phase (PLAN.md present)
if [ -f "PLAN.md" ]; then
    IS_MAINTENANCE=0
    if [ "${ALLOW_NO_PRD:-0}" = "1" ] || [ "${ALLOW_MAINTENANCE_TRACK:-0}" = "1" ]; then
        IS_MAINTENANCE=1
    elif grep -Eiq '(Track:[[:space:]]*(Maintenance|Bugfix|Chore|Refactor)|Maintenance Track|Bugfix Track|\[BUG-FIX|\[CHORE|\[REFACTOR)' "PLAN.md" 2>/dev/null; then
        IS_MAINTENANCE=1
    elif [ "$(git config --get sovereign.track 2>/dev/null || true)" = "maintenance" ]; then
        IS_MAINTENANCE=1
    fi

    if [ "$IS_MAINTENANCE" -eq 1 ]; then
        REQUIRED_FILES=("PLAN.md" "GEMINI.md" "README.md")
    else
        REQUIRED_FILES=("PRD.md" "PLAN.md" "GEMINI.md" "CHANGELOG.md" "README.md")
    fi

    for f in "${REQUIRED_FILES[@]}"; do
        if [ ! -f "$f" ]; then
            echo "[ HARDBLOCK ] File standar proyek wajib ada saat fase eksekusi: $f" >&2
            echo "Untuk proyek Maintenance/Bugfix/Tooling, cantumkan 'Track: Maintenance' di PLAN.md atau jalankan: ALLOW_NO_PRD=1 git commit" >&2
            exit 1
        fi
    done
fi

# 6. Diff-Size Guard (Ponytail / YAGNI Minimalist Diff Law: Max 150 lines)
if [ "${ALLOW_LARGE_DIFF:-0}" != "1" ]; then
    DIFF_STATS=$(git diff --cached --numstat -- . \
        ':!*.lock' \
        ':!package-lock.json' \
        ':!pnpm-lock.yaml' \
        ':!yarn.lock' \
        ':!Cargo.lock' \
        ':!poetry.lock' \
        ':!composer.lock' \
        ':!go.sum' 2>/dev/null || true)
    
    TOTAL_DIFF_LINES=$(echo "$DIFF_STATS" | awk '{
        if ($1 != "-" && $2 != "-") {
            sum += $1 + $2
        }
    } END { print sum+0 }')
    
    if [ "$TOTAL_DIFF_LINES" -gt 150 ]; then
        if [ "$SOVEREIGN_TIER" = "standard" ]; then
            sovereign_warn "Large staged diff (${TOTAL_DIFF_LINES} baris > 150) allowed under standard tier; consider atomic commits."
        else
            echo "[ HARDBLOCK ] Staged diff (${TOTAL_DIFF_LINES} baris) melebihi batas Ponytail / YAGNI (150 baris)!" >&2
            echo "AI diwajibkan memecah pekerjaan menjadi atomic commits / chunks kecil." >&2
            echo "Untuk mengizinkan diff besar jika benar-benar diperlukan, jalankan: ALLOW_LARGE_DIFF=1 git commit" >&2
            exit 1
        fi
    fi
fi

# 7. Dependency Addition Lock (Native Standard Library First)
if [ "${ALLOW_DEP_MUTATION:-0}" != "1" ]; then
    DEP_MUTATION_DETECTED=0
    DEP_DETAILS=""

    # 7a. Check package.json: inspect added dependency keys
    if git diff --cached --name-only | grep -Eq '(^|/)package\.json$'; then
        ADDED_DEPS=$(python3 -c "
import json, subprocess
def get_deps(rev):
    try:
        cmd = ['git', 'show', f'{rev}:package.json'] if rev else ['git', 'show', ':package.json']
        out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL)
        d = json.loads(out)
        return set(d.get('dependencies', {}).keys()) | set(d.get('devDependencies', {}).keys()) | set(d.get('optionalDependencies', {}).keys())
    except Exception:
        return set()
old_d = get_deps('HEAD')
new_d = get_deps('')
added = new_d - old_d
if added:
    print(', '.join(sorted(added)))
" 2>/dev/null || true)
        if [ -n "$ADDED_DEPS" ]; then
            DEP_MUTATION_DETECTED=1
            DEP_DETAILS="${DEP_DETAILS}\n  • package.json: ${ADDED_DEPS}"
        fi
    fi

    # 7b. Check requirements*.txt: newly added non-comment packages
    if git diff --cached --name-only | grep -Eq '(^|/)requirements.*\.txt$'; then
        ADDED_REQS=$(git diff --cached -U0 -- '*requirements*.txt' 2>/dev/null | grep -E '^\+[a-zA-Z0-9_-]+' | tr -d '+' | tr '\n' ', ' || true)
        if [ -n "$ADDED_REQS" ]; then
            DEP_MUTATION_DETECTED=1
            DEP_DETAILS="${DEP_DETAILS}\n  • requirements.txt: ${ADDED_REQS}"
        fi
    fi

    # 7c. Check Cargo.toml: newly added dependencies
    if git diff --cached --name-only | grep -Eq '(^|/)Cargo\.toml$'; then
        ADDED_CARGO=$(git diff --cached -U0 -- '*Cargo.toml' 2>/dev/null | grep -E '^\+[a-zA-Z0-9_-]+\s*=' | grep -vE '^\+(name|version|edition|authors|description|license|readme|repository|homepage|documentation|keywords|categories)\s*=' | tr -d '+' | tr '\n' ', ' || true)
        if [ -n "$ADDED_CARGO" ]; then
            DEP_MUTATION_DETECTED=1
            DEP_DETAILS="${DEP_DETAILS}\n  • Cargo.toml: ${ADDED_CARGO}"
        fi
    fi

    if [ "$DEP_MUTATION_DETECTED" -eq 1 ]; then
        echo "[ HARDBLOCK ] Terdeteksi penambahan third-party dependency baru di staged files!" >&2
        echo -e "Detail penambahan:${DEP_DETAILS}" >&2
        echo "Aturan: Native Standard Library First. Penambahan lib baru membutuhkan persetujuan/RFC." >&2
        echo "Untuk mengizinkan penambahan dependency ini, jalankan: ALLOW_DEP_MUTATION=1 git commit" >&2
        exit 1
    fi
fi

echo "[ PASS ] Pre-commit deterministic checks verified (exit 0)."
exit 0
"""

def load_hook_script(name, fallback):
    try:
        tmpl = REPO_ROOT / "templates" / "git-hooks" / name
        if tmpl.exists():
            text = tmpl.read_text(encoding="utf-8")
            if text.strip():
                return text
    except Exception:
        pass
    return fallback

def load_pre_commit_script():
    return load_hook_script("pre-commit", PRE_COMMIT_SCRIPT)

def load_post_commit_script():
    return load_hook_script("post-commit", POST_COMMIT_SCRIPT)

def load_pre_push_script():
    return load_hook_script("pre-push", PRE_PUSH_SCRIPT)

def cmd_install_pre_commit(args):
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    if not git_root:
        print("[ ERROR ] Current directory is not inside a git repository.", file=sys.stderr)
        sys.exit(1)
        
    hooks_dir = git_root / ".git" / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    pre_commit = hooks_dir / "pre-commit"
    
    pre_commit.write_text(load_pre_commit_script(), encoding="utf-8")
    pre_commit.chmod(0o755)
    print(f"[ SUCCESS ] Anti-Blunder Pre-Commit Hook installed at: {pre_commit}")

def cmd_skill_load(args):
    skill_name = args.name.lower()
    source = SKILLS_ARCHIVE / skill_name
    dest = SKILLS_DIR / skill_name
    
    if not source.exists():
        # Fuzzy match in archive
        matches = [p.name for p in SKILLS_ARCHIVE.iterdir() if skill_name in p.name.lower()]
        if matches:
            source = SKILLS_ARCHIVE / matches[0]
            dest = SKILLS_DIR / matches[0]
        else:
            print(f"[ ERROR ] Skill '{skill_name}' not found in archive ({SKILLS_ARCHIVE}).", file=sys.stderr)
            sys.exit(1)
            
    if dest.exists():
        print(f"[ NOTICE ] Skill '{dest.name}' is already active.")
        return
        
    shutil.copytree(source, dest)
    print(f"[ SUCCESS ] Skill activated: {dest.name} -> {dest}")

def cmd_skill_archive(args):
    skill_name = args.name.lower()
    source = SKILLS_DIR / skill_name
    dest = SKILLS_ARCHIVE / skill_name
    
    if not source.exists():
        print(f"[ ERROR ] Active skill '{skill_name}' not found in {SKILLS_DIR}.", file=sys.stderr)
        sys.exit(1)
        
    SKILLS_ARCHIVE.mkdir(parents=True, exist_ok=True)
    if dest.exists():
        shutil.rmtree(dest)
    shutil.move(source, dest)
    print(f"[ SUCCESS ] Skill archived: {skill_name} -> {dest}")

def cmd_skill_list(args):
    active = sorted([p.name for p in SKILLS_DIR.iterdir() if p.is_dir()]) if SKILLS_DIR.exists() else []
    archived = sorted([p.name for p in SKILLS_ARCHIVE.iterdir() if p.is_dir()]) if SKILLS_ARCHIVE.exists() else []
    
    print(f"=== [ SKILL REGISTRY: {len(active)} ACTIVE | {len(archived)} ARCHIVED ] ===")
    print("\n--- Active Core Skills ---")
    for s in active:
        print(f"  • {s}")
        
    if args.all:
        print(f"\n--- Archived Skills ({len(archived)} items) ---")
        for s in archived[:30]:
            print(f"  • {s}")
        if len(archived) > 30:
            print(f"  ... and {len(archived) - 30} more in archive.")
    else:
        print(f"\n  [ TIP ] Run 'agy-guard skill-list --all' to view all {len(archived)} archived skills.")
        print("  [ TIP ] Run 'agy-guard skill-load <name>' to activate any skill on-demand.")
    print("=================================================================")

def mask_secrets(obj):
    if isinstance(obj, dict):
        res = {}
        for k, v in obj.items():
            if any(s in k.lower() for s in ["key", "token", "secret", "password", "auth", "credential"]):
                res[k] = "[REDACTED]"
            else:
                res[k] = mask_secrets(v)
        return res
    elif isinstance(obj, list):
        return [mask_secrets(i) for i in obj]
    return obj

def cmd_mcp_inspect(args):
    print("=== [ DUAL-FILE MCP DISCOVERY INSPECTION ] ===")
    files = [
        ("Primary Config", CONFIG_DIR / "mcp_config.json"),
        ("Extended Config", CONFIG_DIR / "mcp_config_extended.json"),
    ]
    
    for label, path in files:
        print(f"\n--- {label}: {path} ---")
        if not path.exists():
            print(f"  [ NOT FOUND ] {path}")
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            servers = data.get("mcpServers", {})
            if not servers:
                print("  [ EMPTY ] No mcpServers found.")
                continue
            for sname, sinfo in servers.items():
                cmd = sinfo.get("command", "")
                args_list = sinfo.get("args", [])
                safe_args = mask_secrets(args_list)
                print(f"  • Server: {sname}")
                print(f"    Command: {cmd}")
                print(f"    Args: {json.dumps(safe_args)}")
        except Exception as e:
            print(f"  [ ERROR PARSING ] {e}")
    print("\n==============================================")

def extract_polyglot_block(lines, start_idx):
    open_braces = 0
    started = False
    end_idx = start_idx
    
    for i in range(start_idx, len(lines)):
        line = lines[i]
        stripped = re.sub(r"//.*$|/\*.*?\*/", "", line)
        for char in stripped:
            if char == "{":
                open_braces += 1
                started = True
            elif char == "}":
                open_braces -= 1
                if started and open_braces <= 0:
                    return start_idx, i
        end_idx = i
        if started and open_braces <= 0:
            break
        if i - start_idx > 80:
            break
            
    return start_idx, min(end_idx, start_idx + 45)

def cmd_inspect_symbol(args):
    filepath = Path(args.file)
    symbol = args.symbol
    
    if not filepath.exists():
        print(f"[ ERROR ] File not found: {filepath}", file=sys.stderr)
        sys.exit(1)
        
    lines = filepath.read_text(encoding="utf-8", errors="replace").splitlines()
    found = False
    
    if filepath.suffix == ".py":
        import ast
        try:
            tree = ast.parse("\n".join(lines), filename=str(filepath))
            for node in ast.walk(tree):
                if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                    if node.name == symbol:
                        start = node.lineno
                        end = node.end_lineno if hasattr(node, "end_lineno") else start + 30
                        print(f"=== [ AST SYMBOL: {symbol} in {filepath} (Lines {start}-{end}) ] ===")
                        for idx in range(start - 1, min(end, len(lines))):
                            print(f"{idx+1:4d}: {lines[idx]}")
                        found = True
                        break
        except Exception:
            pass
            
    if not found:
        pattern = re.compile(rf"\b(function|class|const|let|var|def|fn|func|pub\s+fn|type|interface)\s+{re.escape(symbol)}\b|{re.escape(symbol)}\s*[:=]\s*(function|\([^)]*\)\s*=>)")
        for idx, line in enumerate(lines):
            if pattern.search(line) or (symbol in line and any(k in line for k in ["function", "class", "const", "def", "fn", "=>", "func"])):
                start, end = extract_polyglot_block(lines, idx)
                print(f"=== [ POLYGLOT BLOCK: {symbol} in {filepath} (Lines {start+1}-{end+1}) ] ===")
                for i in range(start, end + 1):
                    print(f"{i+1:4d}: {lines[i]}")
                found = True
                break
                
    if not found:
        for idx, line in enumerate(lines):
            if symbol in line:
                start = max(0, idx - 2)
                end = min(len(lines), idx + 30)
                print(f"=== [ MATCH: {symbol} in {filepath} (Lines {start+1}-{end}) ] ===")
                for i in range(start, end):
                    print(f"{i+1:4d}: {lines[i]}")
                found = True
                break
                
    if not found:
        print(f"[ NOT FOUND ] Symbol '{symbol}' not found in {filepath}")

def cmd_find(args):
    """Recursively finds symbol across codebase files."""
    query = args.query
    cwd = Path.cwd()
    print(f"=== [ AGY-GUARD GLOBAL SYMBOL SEARCH: '{query}' ] ===")
    
    extensions = {".py", ".ts", ".tsx", ".js", ".jsx", ".go", ".rs", ".php", ".rb", ".liquid"}
    found_count = 0
    ignored_dirs = {
        "node_modules", "vendor", "__pycache__", "dist", "build", ".venv",
        ".git", ".npm-global", ".cache", ".local", ".gemini", ".agents",
        "Documents", "Downloads", "Music", "Videos", "Desktop", "Pictures", ".cargo", ".rustup"
    }

    # Fast path: prioritize ripgrep (rg) binary if installed
    if shutil.which("rg"):
        pattern = rf"(def|class|function|const|let|var|interface|type|fn|func)\s+.*{re.escape(query)}"
        cmd = ["rg", "-n", "--no-heading", "--color=never", "-e", pattern]
        for ext in sorted(extensions):
            cmd.extend(["-g", f"*{ext}"])
        cmd.extend(["-g", "bin/*"])
        for d in sorted(ignored_dirs):
            cmd.extend(["-g", f"!{d}"])
        try:
            res = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
            if res.returncode == 0 and res.stdout.strip():
                for line in res.stdout.strip().splitlines():
                    parts = line.split(":", 2)
                    if len(parts) >= 2:
                        rel_path, line_no = parts[0], parts[1]
                        fpath = cwd / rel_path
                        try:
                            idx = int(line_no) - 1
                            lines = fpath.read_text(encoding="utf-8", errors="replace").splitlines()
                            start, end = extract_polyglot_block(lines, idx)
                            print(f"\n[ MATCH ] {rel_path} (Lines {start+1}-{end+1})")
                            for i in range(start, min(end + 1, start + 12)):
                                print(f"  {i+1:4d}: {lines[i]}")
                            found_count += 1
                            if found_count >= 8:
                                print("\n[ NOTE ] Capping output at 8 top matches to preserve headroom.")
                                print("=====================================================")
                                return
                        except Exception:
                            pass
            if found_count > 0:
                print("\n=====================================================")
                return
        except Exception:
            pass
    
    for root, dirnames, filenames in os.walk(cwd):
        dirnames[:] = [d for d in dirnames if not d.startswith(".") and d not in ignored_dirs]
        for fname in filenames:
            ext = Path(fname).suffix
            if ext in extensions or Path(root).name == "bin":
                fpath = Path(root) / fname
                try:
                    lines = fpath.read_text(encoding="utf-8", errors="replace").splitlines()
                    for idx, line in enumerate(lines):
                        if query in line and any(k in line for k in ["def ", "class ", "function ", "const ", "interface ", "type ", "fn ", "func "]):
                            rel = fpath.relative_to(cwd)
                            start, end = extract_polyglot_block(lines, idx)
                            print(f"\n[ MATCH ] {rel} (Lines {start+1}-{end+1})")
                            for i in range(start, min(end + 1, start + 12)):
                                print(f"  {i+1:4d}: {lines[i]}")
                            found_count += 1
                            if found_count >= 8:
                                print("\n[ NOTE ] Capping output at 8 top matches to preserve headroom.")
                                print("=====================================================")
                                return
                except Exception:
                    pass
                
    if found_count == 0:
        print(f"  [ NOT FOUND ] No symbol declarations matching '{query}' in {cwd}")
    print("\n=====================================================")

def cmd_inspect_env(args):
    filepath = Path(args.file)
    if not filepath.exists():
        print(f"[ ERROR ] File not found: {filepath}", file=sys.stderr)
        sys.exit(1)
        
    print(f"=== [ SECURE ENV INSPECTION: {filepath.name} ] ===")
    lines = filepath.read_text(encoding="utf-8", errors="replace").splitlines()
    for idx, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" in line:
            key, val = line.split("=", 1)
            key = key.strip()
            val = val.strip().strip("'\"")
            if len(val) <= 4:
                masked = "[REDACTED]"
            else:
                masked = f"{val[:3]}...{val[-2:]} ({len(val)} chars) [MASKED]"
            print(f"  {idx:3d}: {key}={masked}")
        else:
            print(f"  {idx:3d}: {line}")
    print("=================================================")

def cmd_audit_skills(args):
    print("=== [ SKILL REGISTRY AUDIT ] ===")
    active_skills = [p for p in SKILLS_DIR.iterdir() if p.is_dir()] if SKILLS_DIR.exists() else []
    archived_skills = [p for p in SKILLS_ARCHIVE.iterdir() if p.is_dir()] if SKILLS_ARCHIVE.exists() else []
    
    total_bytes = sum((s / "SKILL.md").stat().st_size for s in active_skills if (s / "SKILL.md").exists())
    est_tokens = total_bytes // 4
    
    print(f"  • Active Core Skills   : {len(active_skills)}")
    print(f"  • Archived Skills      : {len(archived_skills)}")
    print(f"  • Active Memory Size   : {total_bytes / 1024:.1f} KB")
    print(f"  • Context Headroom     : ~{est_tokens:,} tokens per turn (Optimized)")
    print("================================")

def cmd_install_hooks_all(args):
    target_dir = Path(args.target_dir) if args.target_dir else HOME / "Projects"
    print(f"=== [ BATCH INSTALLING GIT HOOKS IN {target_dir} ] ===")
    
    installed_count = 0
    skipped_count = 0
    for p in target_dir.iterdir():
        if p.is_dir() and (p / ".git").exists():
            if is_third_party_upstream(p) and not (MEMORY_DIR / p.name).exists():
                print(f"  [ SKIP ] {p.name} (third-party upstream without memory, sovereign hooks withheld)")
                skipped_count += 1
                continue
            hooks_dir = p / ".git" / "hooks"
            hooks_dir.mkdir(parents=True, exist_ok=True)
            
            # 1. post-commit hook
            post_commit = hooks_dir / "post-commit"
            post_commit.write_text(load_post_commit_script(), encoding="utf-8")
            post_commit.chmod(0o755)

            # 2. pre-push hook
            pre_push = hooks_dir / "pre-push"
            pre_push.write_text(load_pre_push_script(), encoding="utf-8")
            pre_push.chmod(0o755)
            
            # 3. pre-commit hook
            pre_commit = hooks_dir / "pre-commit"
            pre_commit.write_text(load_pre_commit_script(), encoding="utf-8")
            pre_commit.chmod(0o755)
            
            print(f"  [ INSTALLED ] {p.name} (pre-commit + post-commit + pre-push)")
            installed_count += 1

    print(f"[ SUCCESS ] Installed 3 hooks across {installed_count} repositories ({skipped_count} third-party skipped).")

def cmd_set_global_git_templates(args):
    tpl_dir = HOME / ".git-templates" / "hooks"
    tpl_dir.mkdir(parents=True, exist_ok=True)
    
    post_commit = tpl_dir / "post-commit"
    post_commit.write_text(load_post_commit_script(), encoding="utf-8")
    post_commit.chmod(0o755)

    pre_push = tpl_dir / "pre-push"
    pre_push.write_text(load_pre_push_script(), encoding="utf-8")
    pre_push.chmod(0o755)
    
    pre_commit = tpl_dir / "pre-commit"
    pre_commit.write_text(load_pre_commit_script(), encoding="utf-8")
    pre_commit.chmod(0o755)
    
    subprocess.run(["git", "config", "--global", "init.templateDir", str(HOME / ".git-templates")], check=True)
    print(f"[ SUCCESS ] Global git template set to: {HOME / '.git-templates'}")
    print("  • All future 'git init' or 'git clone' repositories will automatically inherit pre-commit, post-commit, and pre-push hooks.")

def cmd_scaffold_all_projects(args):
    target_dir = Path(args.target_dir) if args.target_dir else HOME / "Projects"
    print(f"=== [ BATCH SCAFFOLDING OBSIDIAN RAG MEMORY IN {target_dir} ] ===")
    
    scaffolded_count = 0
    enriched_count = 0
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
    for p in target_dir.iterdir():
        if p.is_dir() and not p.name.startswith("."):
            ns = p.name
            ns_dir = MEMORY_DIR / ns
            ns_dir.mkdir(parents=True, exist_ok=True)
            
            commit, branch, _ = get_git_info(p)
            
            # Detect tech stack
            tech = "Generic Codebase"
            if (p / "package.json").exists():
                tech = "Node.js / JavaScript / TypeScript"
            elif (p / "composer.json").exists():
                tech = "PHP / Laravel / Composer"
            elif (p / "Cargo.toml").exists():
                tech = "Rust / Cargo"
            elif (p / "go.mod").exists():
                tech = "Golang"
            elif (p / "requirements.txt").exists() or (p / "pyproject.toml").exists():
                tech = "Python"
            elif (p / "config.yml").exists() or "theme" in p.name.lower():
                tech = "Shopify Liquid Theme"
                
            # 1. INDEX.md
            index_file = ns_dir / "INDEX.md"
            if not index_file.exists():
                index_content = f"""# PROJECT INDEX — {ns}

- **Local Path**: `{p}`
- **Primary Tech Stack**: {tech}
- **Git Commit Hash**: `{commit}`
- **Active Branch**: `{branch}`
- **Obsidian Namespace**: `00-AGY-Memory/{ns}/`
"""
                index_file.write_text(index_content.strip() + "\n", encoding="utf-8")
                
            # 2. CONTEXT.md (Anthropic Contextual Enrichment)
            ctx_file = ns_dir / "CONTEXT.md"
            if not ctx_file.exists():
                ctx_content = build_enriched_context_content(ns, p, tech)
                ctx_file.write_text(ctx_content.strip() + "\n", encoding="utf-8")
            else:
                old_ctx = ctx_file.read_text(encoding="utf-8")
                if "Known Gotchas" not in old_ctx and "Gotchas" not in old_ctx:
                    gotchas_sec = build_contextual_gotchas(tech, p)
                    enriched_ctx = old_ctx.rstrip() + f"\n\n## Known Gotchas & Environment Traps\n{gotchas_sec}\n"
                    if len(enriched_ctx.splitlines()) <= 200:
                        ctx_file.write_text(enriched_ctx, encoding="utf-8")
                        enriched_count += 1
                        print(f"  [ CONTEXT ENRICHED ] {ns}/CONTEXT.md (+Known Gotchas)")
                
            # 3. STATE.md (Subagent Alignment)
            state_file = ns_dir / "STATE.md"
            if not state_file.exists():
                state_content = build_enriched_state_content(ns, p, commit, branch, 0, "ACTIVE", "Initialized project memory via agy-guard scaffold-all-projects", now)
                state_file.write_text(state_content.strip() + "\n", encoding="utf-8")
                
            # 4. DECISIONS.md
            dec_file = ns_dir / "DECISIONS.md"
            if not dec_file.exists():
                dec_content = f"""# ARCHITECTURAL DECISIONS (ADR) — {ns}

## ADR-001: [ACTIVE] Project Architecture Initialization
- **Date**: {now[:10]}
- **Context**: Project namespace memory initialized.
- **Decision**: Adhere to 4-file memory schema and strict namespace isolation.

## Standard Laws
- **Law 1**: Ponytail / YAGNI - Minimalist code generation, zero unsolicited refactoring.
- **Law 2**: Empirical Verification - Always verify build/test before concluding task.
- **Law 3**: Git Push Guard - Remote push forbidden without explicit human command.
"""
                dec_file.write_text(dec_content.strip() + "\n", encoding="utf-8")
                
            print(f"  [ MEMORY INITIALIZED ] {ns} -> 00-AGY-Memory/{ns}/")
            scaffolded_count += 1
            
    print(f"[ SUCCESS ] Scaffolding complete for {scaffolded_count} project namespaces (Contextual Traps Enriched: {enriched_count}) in Obsidian.")

def cmd_verify(args):
    """Auto-detects project stack and executes empirical verification with Circuit Breaker."""
    cwd = Path.cwd()
    git_root = get_git_root(cwd)
    breaker_file = (git_root / ".git" / "circuit_breaker.count") if git_root else (cwd / ".circuit_breaker.count")
    
    print("=== [ EMPIRICAL VERIFICATION AUTO-RUNNER ] ===")
    
    cmd = None
    if (cwd / "package.json").exists():
        try:
            pkg = json.loads((cwd / "package.json").read_text(encoding="utf-8"))
            scripts = pkg.get("scripts", {})
            if "test" in scripts and "no test specified" not in scripts["test"]:
                cmd = ["npm", "test"]
            elif "build" in scripts:
                cmd = ["npm", "run", "build"]
            elif "check" in scripts:
                cmd = ["npm", "run", "check"]
            elif (cwd / "tsconfig.json").exists():
                cmd = ["npx", "tsc", "--noEmit"]
        except Exception:
            pass
    elif (cwd / "Cargo.toml").exists():
        cmd = ["cargo", "check"]
    elif (cwd / "go.mod").exists():
        cmd = ["go", "test", "./..."]
    elif (cwd / "composer.json").exists():
        cmd = ["composer", "test"] if "test" in (cwd / "composer.json").read_text() else ["php", "-l", "index.php"]
    elif (cwd / "pytest.ini").exists() or (cwd / "tests").exists() or (cwd / "pyproject.toml").exists():
        cmd = ["pytest"]
    elif "theme" in cwd.name.lower() or (cwd / "config.yml").exists() or (cwd / "sections").exists():
        cmd = ["shopify", "theme", "check"]
    elif (cwd / "bin" / "agy-guard").exists() or list(cwd.glob("scripts/*.sh")) or list(cwd.glob("*.sh")):
        cmd = ["bash", "-c", 'set -e; for f in $(find . -maxdepth 2 -type f -name "*.sh"); do bash -n "$f"; done; if [ -f bin/agy-guard ]; then python3 -m py_compile bin/agy-guard; fi; for f in $(find . -maxdepth 2 -type f -name "*.py" ! -path "*/__pycache__/*"); do python3 -m py_compile "$f"; done; if [ -f plugins/agent-skills/scripts/validate-skills.js ]; then node plugins/agent-skills/scripts/validate-skills.js >/dev/null && node plugins/agent-skills/scripts/validate-commands.js >/dev/null; fi; echo "[ PASS ] Internal scripts & tooling syntax verified."']
        
    if not cmd:
        if (cwd / ".git").exists():
            cmd = ["git", "status", "--short"]
        else:
            print("  [ NOTICE ] No automated test suite or git tracking in active workspace.")
            print("  [ PASS ] Workspace syntax check verified (Clean).")
            print("==============================================")
            return

    print(f"  • Running Command: {' '.join(cmd)}")
    try:
        res = subprocess.run(cmd, cwd=cwd, text=True, capture_output=True, timeout=120)
        
        # Zero-Test Trap Defense (Non-Empty Pass Mandate)
        output_combined = f"{res.stdout or ''}\n{res.stderr or ''}"
        is_test_cmd = any(k in " ".join(cmd).lower() for k in ["test", "pytest", "jest", "vitest"])
        zero_test_detected = False
        matched_zero_pattern = ""
        
        if is_test_cmd or "pytest" in output_combined.lower() or "passed" in output_combined.lower():
            zero_patterns = [
                r"collected 0 items",
                r"0 passed,\s*0 failed",
                r"no tests ran",
                r"No tests found",
                r"Tests:\s+0 (passed,\s+)?0 total",
                r"Tests:\s+0 passed",
                r"Ran 0 tests",
                r"running 0 tests",
                r"test result: ok\.\s*0 passed;\s*0 failed",
                r"\[no test files\]"
            ]
            for pat in zero_patterns:
                if re.search(pat, output_combined, re.IGNORECASE):
                    zero_test_detected = True
                    matched_zero_pattern = pat
                    break

        if res.returncode == 0 and not zero_test_detected:
            if breaker_file.exists():
                try:
                    breaker_file.unlink()
                except Exception:
                    pass
            print("  [ PASS ] Verification exit code 0 (Success).")
            if res.stdout:
                lines = res.stdout.strip().splitlines()
                for l in lines[-6:]:
                    print(f"    {l}")
        else:
            fail_count = 0
            if breaker_file.exists():
                try:
                    fail_count = int(breaker_file.read_text(encoding="utf-8").strip())
                except Exception:
                    fail_count = 0
            fail_count += 1
            
            if zero_test_detected and res.returncode == 0:
                print(f"  [ ZERO-TEST TRAP DETECTED ] Runner exited code 0 but executed 0 tests!")
                print(f"  • Matched indicator: '{matched_zero_pattern}'")
                print("  • Non-Empty Pass Mandate violated: test_count must be > 0.")
                effective_code = 1
            else:
                effective_code = res.returncode
            
            print(f"  [ FAIL ] Verification exited with code {effective_code} (Attempt {fail_count}/3):")
            out = (res.stderr or res.stdout).strip().splitlines()
            for l in out[:15]:
                print(f"    [ERR] {l}")
                
            if fail_count >= 3:
                if breaker_file.exists():
                    try:
                        breaker_file.unlink()
                    except Exception:
                        pass
                print("\n  [ CIRCUIT BREAKER TRIPPED ] 3 consecutive verification failures detected!")
                print("  [ EMERGENCY ACTION ] Rolling back uncommitted mutations to prevent death loop...")
                if git_root:
                    subprocess.run(["git", "restore", "."], cwd=git_root)
                
                # Auto-update Obsidian STATE.md to BLOCKED
                try:
                    ns = resolve_namespace(cwd)
                    target_dir = MEMORY_DIR / ns
                    state_file = target_dir / "STATE.md"
                    if state_file.exists():
                        commit, branch, dirty = get_git_info(cwd)
                        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                        state_content = f"""# ACTIVE STATE — {ns}

- **Last Checkpoint**: {now}
- **Status**: BLOCKED
- **Git Branch**: `{branch}`
- **Git Commit**: `{commit}`
- **Uncommitted Changes**: {dirty} file(s)

---

## Active Milestone / Task
- **Summary**: [CIRCUIT BREAKER TRIPPED] 3 consecutive verification failures detected. Uncommitted mutations rolled back.
- **Checkpoint Context**: Tripped by `agy-guard verify`

## Invariant Checks
- [x] Ponytail / YAGNI Minimalist verified
- [x] Strict No-Emoji compliant
- [x] Git push permission checked (local only)
- [ ] Verification passed (BLOCKED: Requires human guidance or RFC)
"""
                        state_file.write_text(state_content.strip() + "\n", encoding="utf-8")
                        print(f"  [ STATE UPDATED ] {state_file} marked as BLOCKED.")
                except Exception as e:
                    print(f"  [ WARN ] Could not update STATE.md: {e}")

                print("  [ HARD STOP ] AI self-healing halted. Raw error reported above. Exiting with code 126.")
                sys.exit(126)
            else:
                try:
                    breaker_file.write_text(str(fail_count), encoding="utf-8")
                    print(f"  [ CIRCUIT BREAKER ] Failure recorded ({fail_count}/3). Self-heal allowed.")
                except Exception:
                    pass
            sys.exit(effective_code or 1)
    except Exception as e:
        print(f"  [ ERROR ] Could not execute verification: {e}")
        sys.exit(1)
    print("==============================================")

def detect_stack_fingerprint(root_path):
    """Generates a high-density technical stack fingerprint."""
    info = []
    engine = "Generic Codebase"
    gates = []

    pkg_file = root_path / "package.json"
    if pkg_file.exists():
        try:
            data = json.loads(pkg_file.read_text(encoding="utf-8"))
            name = data.get("name", root_path.name)
            scripts = list(data.get("scripts", {}).keys())
            deps = {**data.get("dependencies", {}), **data.get("devDependencies", {})}
            key_frameworks = [f for f in ["next", "react", "vue", "express", "fastify", "typescript", "vitest", "jest", "tailwindcss"] if f in deps]
            engine = f"Node.js ({data.get('type', 'commonjs')})"
            if key_frameworks:
                engine += f" [Frameworks: {', '.join(key_frameworks)}]"
            info.append(f"• Manifest       : package.json (Name: {name}, Dependencies: {len(deps)})")
            if scripts:
                gates.append(f"npm run [{', '.join(scripts[:6])}]")
        except Exception:
            engine = "Node.js (Malformed package.json)"

    cargo_file = root_path / "Cargo.toml"
    if cargo_file.exists():
        engine = "Rust (Cargo)"
        gates.append("cargo check / cargo test")
        info.append("• Manifest       : Cargo.toml")

    go_file = root_path / "go.mod"
    if go_file.exists():
        engine = "Golang"
        gates.append("go vet / go test ./...")
        try:
            first_line = go_file.read_text(encoding="utf-8").splitlines()[0]
            info.append(f"• Manifest       : go.mod ({first_line.strip()})")
        except Exception:
            info.append("• Manifest       : go.mod")

    py_indicators = [root_path / "pyproject.toml", root_path / "requirements.txt", root_path / "setup.py", root_path / "pytest.ini"]
    py_files = [p.name for p in py_indicators if p.exists()]
    if py_files or (root_path / "tests").exists() or list(root_path.glob("*.py")):
        engine = "Python"
        gates.append("pytest / python3 -m py_compile")
        if py_files:
            info.append(f"• Manifest       : {', '.join(py_files)}")
        elif (root_path / "tests").exists():
            info.append("• Test Suite     : tests/ (pytest)")

    if list(root_path.glob("scripts/*.sh")) or list(root_path.glob("*.sh")):
        gates.append("bash -n scripts/*.sh")

    composer_file = root_path / "composer.json"
    if composer_file.exists():
        engine = "PHP / Composer"
        gates.append("composer test / php -l")
        info.append("• Manifest       : composer.json")

    docker_files = [root_path / "docker-compose.yml", root_path / "compose.yaml", root_path / "Dockerfile"]
    found_docker = [d.name for d in docker_files if d.exists()]
    if found_docker:
        info.append(f"• Container      : {', '.join(found_docker)}")

    return engine, info, gates

def cmd_prep(args):
    """Pre-flight one-shot agent onboarding briefing (Track A/B Cold-Start)."""
    cwd = Path.cwd()
    ns = resolve_namespace(cwd)
    git_root = get_git_root(cwd)
    root_path = git_root or cwd
    commit, branch, dirty = get_git_info(cwd)
    
    print("=== [ PRE-FLIGHT AGENT ONBOARDING BRIEFING ] ===")
    print(f"  • Active Namespace    : {ns}")
    print(f"  • Git Root Path       : {root_path}")
    print(f"  • Git Branch / Commit : {branch} ({commit[:8]})")
    print(f"  • Modified / Untracked: {dirty} file(s)")
    
    # 1. Recent commits & working tree
    try:
        commits = subprocess.check_output(
            ["git", "log", "-n", "3", "--oneline"],
            cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip().splitlines()
        if commits:
            print("\n--- [ RECENT COMMITS (LAST 3) ] ---")
            for c in commits:
                print(f"  {c}")
    except Exception:
        pass

    if dirty > 0:
        try:
            status_lines = subprocess.check_output(
                ["git", "status", "--short"],
                cwd=cwd, stderr=subprocess.DEVNULL, text=True
            ).strip().splitlines()
            if status_lines:
                print("\n--- [ WORKING TREE DIFF SUMMARY ] ---")
                for s in status_lines[:6]:
                    print(f"  {s}")
                if len(status_lines) > 6:
                    print(f"  ... (+{len(status_lines) - 6} more files)")
        except Exception:
            pass

    # 2. Stack Fingerprint
    engine, manifest_info, gates = detect_stack_fingerprint(root_path)
    print("\n--- [ STACK FINGERPRINT ] ---")
    print(f"  • Primary Engine      : {engine}")
    for item in manifest_info:
        print(f"  {item}")
    if gates:
        print(f"  • Verification Gates  : {' | '.join(gates)}")

    # 3. Known Gotchas & Environment Traps from CONTEXT.md
    ctx_file = MEMORY_DIR / ns / "CONTEXT.md"
    gotchas_lines = []
    if ctx_file.exists():
        try:
            text = ctx_file.read_text(encoding="utf-8")
            if "## Known Gotchas & Environment Traps" in text:
                part = text.split("## Known Gotchas & Environment Traps", 1)[1]
                if "\n## " in part:
                    part = part.split("\n## ", 1)[0]
                gotchas_lines = [l.strip() for l in part.splitlines() if l.strip()]
        except Exception:
            pass

    print("\n--- [ KNOWN GOTCHAS & ENVIRONMENT TRAPS ] ---")
    if gotchas_lines:
        for g in gotchas_lines[:8]:
            print(f"  {g}")
    else:
        fallback_gotchas = build_contextual_gotchas(engine, root_path).splitlines()
        for g in fallback_gotchas[:6]:
            print(f"  {g}")

    # 4. Active Checklist from STATE.md
    state_file = MEMORY_DIR / ns / "STATE.md"
    active_tasks = []
    if state_file.exists():
        try:
            stext = state_file.read_text(encoding="utf-8")
            for line in stext.splitlines():
                stripped = line.strip()
                if any(stripped.startswith(prefix) for prefix in ["- [ ]", "- [-]", "- [x]", "* [ ]", "* [-]", "* [x]"]):
                    active_tasks.append(stripped)
                elif "Active Tasks" in line or "Status State" in line or "Task Message" in line:
                    active_tasks.append(f"• {stripped.lstrip('#').strip()}")
        except Exception:
            pass

    print("\n--- [ ACTIVE STATE & CHECKLIST (STATE.md) ] ---")
    if active_tasks:
        for t in active_tasks[:8]:
            print(f"  {t}")
    else:
        print("  • [ NOTE ] No pending checklist tasks found in STATE.md. Clean slate.")

    # 5. Local PLAN.md or PRD.md
    plan_file = root_path / "PLAN.md"
    prd_file = root_path / "PRD.md"
    if plan_file.exists():
        print("\n--- [ LOCAL PLAN.md DETECTED ] ---")
        lines = plan_file.read_text(encoding="utf-8", errors="replace").splitlines()
        for l in lines[:6]:
            print(f"  {l}")
    elif prd_file.exists():
        print("\n--- [ LOCAL PRD.md DETECTED ] ---")
        lines = prd_file.read_text(encoding="utf-8", errors="replace").splitlines()
        for l in lines[:6]:
            print(f"  {l}")

    print("\n================================================")

def cmd_prune_brain(args):
    """Vacuum and garbage collect stale task logs and inactive session traces in ~/.gemini/antigravity-cli/brain."""
    brain_dir = BRAIN_DIR
    presence_dir = PRESENCE_DIR
    
    if not brain_dir.exists():
        print(f"[ NOTICE ] Brain directory does not exist: {brain_dir}")
        return

    max_size_bytes = int(args.max_size_mb * 1024 * 1024)
    max_age_sec = int(args.max_age_days * 86400)
    now = time.time()
    dry_run = args.dry_run

    print("=== [ AGY BRAIN GARBAGE COLLECTION & VACUUM ] ===")
    print(f"  • Brain Path        : {brain_dir}")
    print(f"  • Mode              : {'DRY-RUN (Simulation)' if dry_run else 'ACTIVE (Purging & Compressing)'}")
    print(f"  • Task Log Threshold: > {args.max_size_mb:.1f} MB or > {args.max_age_days} days old")
    print(f"  • Inactive Threshold: > {args.max_age_days} days without modification")
    print("------------------------------------------------")

    # 1. Identify Protected Active Sessions
    protected_sessions = set()
    if presence_dir.exists():
        for p in presence_dir.glob("*.lock"):
            protected_sessions.add(p.stem)
            
    # Protect any session modified within last 12 hours
    sessions = [d for d in brain_dir.iterdir() if d.is_dir() and not d.name.startswith(".")]
    for d in sessions:
        try:
            mtime = d.stat().st_mtime
            if (now - mtime) < 43200:  # 12 hours
                protected_sessions.add(d.name)
        except Exception:
            pass

    # Current conversation ID from env
    for env_k in ["CONVERSATION_ID", "GEMINI_CONVERSATION_ID", "AGY_CONVERSATION_ID"]:
        if os.environ.get(env_k):
            protected_sessions.add(os.environ[env_k])

    # 2. Prune / Truncate task-*.log files
    task_logs = list(brain_dir.glob("*/.system_generated/tasks/task-*.log"))
    pruned_logs_count = 0
    reclaimed_logs_bytes = 0

    for tf in task_logs:
        try:
            st = tf.stat()
            sz = st.st_size
            age_sec = now - st.st_mtime
            
            session_id = tf.parent.parent.parent.name
            is_protected = session_id in protected_sessions

            if age_sec > max_age_sec and not is_protected:
                pruned_logs_count += 1
                reclaimed_logs_bytes += sz
                if not dry_run:
                    tf.unlink(missing_ok=True)
            elif sz > max_size_bytes:
                keep_bytes = min(20480, sz)
                pruned_logs_count += 1
                reclaimed_logs_bytes += (sz - keep_bytes)
                if not dry_run:
                    try:
                        with open(tf, "rb") as f:
                            f.seek(max(0, sz - keep_bytes))
                            tail_bytes = f.read()
                        with open(tf, "wb") as f:
                            f.write(f"[ TRUNCATED BY agy-guard prune-brain: Original size {sz/(1024*1024):.2f} MB ]\n\n".encode("utf-8"))
                            f.write(tail_bytes)
                    except Exception:
                        pass
        except Exception:
            pass

    # 3. Compress inactive session transcripts
    compressed_transcripts_count = 0
    reclaimed_transcripts_bytes = 0
    
    if not args.no_compress:
        for s in sessions:
            if s.name in protected_sessions:
                continue
            try:
                s_age_sec = now - s.stat().st_mtime
                if s_age_sec > max_age_sec:
                    logs_dir = s / ".system_generated" / "logs"
                    if logs_dir.exists():
                        for jf in logs_dir.glob("transcript*.jsonl"):
                            if jf.is_file() and not jf.name.endswith(".gz"):
                                sz = jf.stat().st_size
                                if sz > 10240:
                                    compressed_transcripts_count += 1
                                    if dry_run:
                                        est_savings = int(sz * 0.8)
                                        reclaimed_transcripts_bytes += est_savings
                                    else:
                                        gz_path = jf.with_name(jf.name + ".gz")
                                        with open(jf, "rb") as f_in, gzip.open(gz_path, "wb", compresslevel=6) as f_out:
                                            shutil.copyfileobj(f_in, f_out)
                                        gz_sz = gz_path.stat().st_size
                                        jf.unlink()
                                        reclaimed_transcripts_bytes += (sz - gz_sz)
            except Exception:
                pass

    # 4. Clean dead scratch directories in inactive sessions
    cleaned_scratch_dirs = 0
    reclaimed_scratch_bytes = 0
    for s in sessions:
        if s.name in protected_sessions:
            continue
        try:
            s_age_sec = now - s.stat().st_mtime
            if s_age_sec > max_age_sec:
                scratch_dir = s / "scratch"
                if scratch_dir.exists() and scratch_dir.is_dir():
                    s_files = [f for f in scratch_dir.rglob("*") if f.is_file()]
                    if s_files:
                        scratch_sz = sum(f.stat().st_size for f in s_files)
                        cleaned_scratch_dirs += 1
                        reclaimed_scratch_bytes += scratch_sz
                        if not dry_run:
                            shutil.rmtree(scratch_dir, ignore_errors=True)
                            scratch_dir.mkdir(exist_ok=True)
        except Exception:
            pass

    # 5. Clean dead step traces in inactive sessions
    cleaned_steps_count = 0
    reclaimed_steps_bytes = 0
    for s in sessions:
        if s.name in protected_sessions:
            continue
        try:
            s_age_sec = now - s.stat().st_mtime
            if s_age_sec > max_age_sec:
                steps_dir = s / ".system_generated" / "steps"
                if steps_dir.exists() and steps_dir.is_dir():
                    s_files = [f for f in steps_dir.rglob("*") if f.is_file()]
                    if s_files:
                        step_sz = sum(f.stat().st_size for f in s_files)
                        cleaned_steps_count += len(s_files)
                        reclaimed_steps_bytes += step_sz
                        if not dry_run:
                            shutil.rmtree(steps_dir, ignore_errors=True)
                            steps_dir.mkdir(exist_ok=True)
        except Exception:
            pass

    # 6. Clean redundant chunk slices in inactive sessions
    cleaned_chunks_count = 0
    reclaimed_chunks_bytes = 0
    for s in sessions:
        if s.name in protected_sessions:
            continue
        try:
            s_age_sec = now - s.stat().st_mtime
            if s_age_sec > max_age_sec:
                chunks_dir = s / ".system_generated" / "logs" / "chunks"
                if chunks_dir.exists() and chunks_dir.is_dir():
                    c_files = [f for f in chunks_dir.rglob("*") if f.is_file()]
                    if c_files:
                        c_sz = sum(f.stat().st_size for f in c_files)
                        cleaned_chunks_count += len(c_files)
                        reclaimed_chunks_bytes += c_sz
                        if not dry_run:
                            shutil.rmtree(chunks_dir, ignore_errors=True)
        except Exception:
            pass

    total_reclaimed_mb = (reclaimed_logs_bytes + reclaimed_transcripts_bytes + reclaimed_scratch_bytes + reclaimed_steps_bytes + reclaimed_chunks_bytes) / (1024 * 1024)
    print(f"  • Sessions Scanned     : {len(sessions)} ({len(protected_sessions)} active/protected)")
    print(f"  • Task Logs Vacuumed   : {pruned_logs_count} files ({reclaimed_logs_bytes / (1024*1024):.2f} MB)")
    print(f"  • Transcripts Gzipped  : {compressed_transcripts_count} files ({reclaimed_transcripts_bytes / (1024*1024):.2f} MB)")
    print(f"  • Dead Scratch Cleaned : {cleaned_scratch_dirs} dirs ({reclaimed_scratch_bytes / (1024*1024):.2f} MB)")
    print(f"  • Step Traces Pruned   : {cleaned_steps_count} files ({reclaimed_steps_bytes / (1024*1024):.2f} MB)")
    print(f"  • Stream Chunks Purged : {cleaned_chunks_count} files ({reclaimed_chunks_bytes / (1024*1024):.2f} MB)")
    print("------------------------------------------------")
    print(f"[ TOTAL SPACE RECLAIMED ] : {total_reclaimed_mb:.2f} MB")
    
    if dry_run:
        print("\n[ NOTE ] Dry-run mode completed. Zero files modified. Run without --dry-run to purge.")
    else:
        print("\n[ SUCCESS ] Vacuum completed. Brain storage optimized.")
    print("================================================")

def cmd_diff_guard(args):
    """Audits diff radius (Ponytail YAGNI) and flags sensitive area violations."""
    cwd = Path.cwd()
    print("=== [ PONYTAIL DIFF & SENSITIVE AREA AUDIT ] ===")
    
    try:
        diff_out = subprocess.check_output(
            ["git", "diff", "HEAD", "--name-status"], cwd=cwd, stderr=subprocess.DEVNULL, text=True
        ).strip().splitlines()
    except Exception:
        diff_out = []
        
    if not diff_out:
        print("  [ CLEAN ] Working tree has no uncommitted changes.")
        print("================================================")
        return
        
    sensitive_keywords = ["auth", "login", "payment", "stripe", "paypal", "migration", "schema", ".env", "docker-compose", ".github", "workflow"]
    violations = []
    
    print(f"  • Total Changed Files: {len(diff_out)}")
    for item in diff_out:
        parts = item.split(None, 1)
        if len(parts) == 2:
            status, fname = parts
            is_sensitive = any(k in fname.lower() for k in sensitive_keywords)
            flag = " [ SENSITIVE AREA HARD-STOP ]" if is_sensitive else ""
            print(f"    [{status}] {fname}{flag}")
            if is_sensitive:
                violations.append(fname)
                
    if violations:
        print("\n  [ CAUTION ] Sensitive areas modified! Human authorization REQUIRED before commit/merge:")
        for v in violations:
            print(f"    -> {v}")
    else:
        print("\n  [ OK ] No sensitive surfaces detected. Ponytail minimal diff compliant.")
    print("================================================")

def cmd_push(args):
    """Executes safe human-authorized git push."""
    cwd = Path.cwd()
    env = os.environ.copy()
    env["ALLOW_GIT_PUSH"] = "1"
    
    push_args = ["git", "push"] + (args.git_args or [])
    print(f"=== [ AUTHORIZED GIT PUSH: {' '.join(push_args)} ] ===")
    
    try:
        res = subprocess.run(push_args, cwd=cwd, env=env, text=True)
        if res.returncode == 0:
            print("[ SUCCESS ] Git push completed successfully.")
        else:
            print(f"[ ERROR ] Git push failed with exit code {res.returncode}")
            sys.exit(res.returncode)
    except Exception as e:
        print(f"[ ERROR ] Failed to execute push: {e}")
        sys.exit(1)

def cmd_commit(args):
    """Executes deterministic agentic git commit without GPG deadlock."""
    cwd = Path.cwd()
    env = os.environ.copy()
    
    if getattr(args, "large", False):
        env["ALLOW_LARGE_DIFF"] = "1"
    if getattr(args, "allow_test", False):
        env["ALLOW_TEST_MUTATION"] = "1"
        
    commit_cmd = ["git", "commit", "-m", args.msg]
    
    # By default, disable GPG signing for agentic autonomous commits to avoid passphrase hang
    if not getattr(args, "gpg_sign", False):
        commit_cmd.append("--no-gpg-sign")
        
    if args.git_args:
        commit_cmd.extend(args.git_args)
        
    print(f"=== [ AGENTIC COMMIT: {' '.join(commit_cmd)} ] ===")
    try:
        res = subprocess.run(commit_cmd, cwd=cwd, env=env, text=True)
        if res.returncode == 0:
            print("[ SUCCESS ] Agentic commit created cleanly.")
        else:
            print(f"[ ERROR ] Git commit failed with exit code {res.returncode}")
            sys.exit(res.returncode)
    except Exception as e:
        print(f"[ ERROR ] Failed to execute commit: {e}")
        sys.exit(1)

def cmd_tdd(args):
    """Executes test harness loop for Agentic TDD (Track A)."""
    cwd = Path.cwd()
    test_cmd = args.command
    print(f"=== [ AGENTIC TDD HARNESS: {test_cmd} ] ===")
    start_time = time.time()
    try:
        res = subprocess.run(test_cmd, shell=True, cwd=cwd, text=True, capture_output=True)
        duration = time.time() - start_time
        stdout = res.stdout.strip()
        stderr = res.stderr.strip()
        
        if res.returncode == 0:
            print(f"[ PASS ] Harness verified in {duration:.2f}s (Exit code 0)")
            if stdout:
                lines = stdout.splitlines()
                for line in lines[-10:]:
                    print(f"  {line}")
        else:
            print(f"[ FAIL ] Harness failed in {duration:.2f}s (Exit code {res.returncode})")
            err_output = stderr if stderr else stdout
            lines = err_output.splitlines()
            for line in lines[-15:]:
                print(f"  [TRACE] {line}")
            sys.exit(res.returncode)
    except Exception as e:
        print(f"[ ERROR ] Failed to execute TDD command: {e}")
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(
        description="agy-guard v5.2: Deterministic Guardrails & Governance for AI Agents"
    )
    subparsers = parser.add_subparsers(dest="subcommand", required=True)
    
    # sync-rules
    subparsers.add_parser("sync-rules", help="Synchronize all GEMINI.md rule files").set_defaults(func=cmd_sync_rules)
    
    # status
    sub_status = subparsers.add_parser("status", help="Show system rules, git root, and MCP health status")
    sub_status.add_argument("--fix", action="store_true", help="Automatically repair rule drift, missing hooks, and memory files")
    sub_status.set_defaults(func=cmd_status)
    
    # context
    subparsers.add_parser("context", help="Instant high-density project briefing for new sessions").set_defaults(func=cmd_context)
    
    # prep
    subparsers.add_parser("prep", help="One-shot agent pre-flight onboarding briefing").set_defaults(func=cmd_prep)
    
    # prune-brain
    sub_prune = subparsers.add_parser("prune-brain", help="Vacuum and garbage collect stale task logs and inactive session traces in brain", description="Vacuum and garbage collect stale task logs and inactive session traces in ~/.gemini/antigravity-cli/brain")
    sub_prune.add_argument("--max-size-mb", type=float, default=2.0, help="Size threshold in MB to truncate task-*.log (default: 2.0)")
    sub_prune.add_argument("--max-age-days", type=int, default=7, help="Age threshold in days for task logs and scratch (default: 7)")
    sub_prune.add_argument("--dry-run", action="store_true", help="Simulate vacuum and calculate reclaimable space without modifying files")
    sub_prune.add_argument("--no-compress", action="store_true", help="Skip gzipping inactive transcripts")
    sub_prune.set_defaults(func=cmd_prune_brain)
    
    # verify
    subparsers.add_parser("verify", help="Auto-detect and run empirical test/linter verification").set_defaults(func=cmd_verify)
    
    # diff-guard
    subparsers.add_parser("diff-guard", help="Audit diff radius and check for sensitive area violations").set_defaults(func=cmd_diff_guard)
    
    # push
    sub_push = subparsers.add_parser("push", help="Execute safe human-authorized git push")
    sub_push.add_argument("git_args", nargs="*", help="Arguments to pass to git push")
    sub_push.set_defaults(func=cmd_push)
    
    # commit
    sub_commit = subparsers.add_parser("commit", help="Execute safe agentic git commit without GPG deadlock")
    sub_commit.add_argument("-m", "--msg", required=True, help="Commit message")
    sub_commit.add_argument("--large", action="store_true", help="Allow large diff (>150 lines)")
    sub_commit.add_argument("--allow-test", action="store_true", help="Allow test file modification")
    sub_commit.add_argument("--gpg-sign", action="store_true", help="Enable GPG signing (requires interactive PIN prompt)")
    sub_commit.add_argument("git_args", nargs="*", help="Additional arguments to pass to git commit")
    sub_commit.set_defaults(func=cmd_commit)

    # tdd
    sub_tdd = subparsers.add_parser("tdd", help="Run test command as Agentic TDD harness (Track A)")
    sub_tdd.add_argument("command", help="Test command to run (e.g. 'pytest', 'npm test')")
    sub_tdd.set_defaults(func=cmd_tdd)
    
    # checkpoint
    sub_cp = subparsers.add_parser("checkpoint", help="Log deterministic state checkpoint to Obsidian RAG with Self-RAG groundedness audit", description="Log deterministic state checkpoint to Obsidian RAG with Self-RAG groundedness audit")
    sub_cp.add_argument("-m", "--msg", type=str, default="Task milestone completed", help="Checkpoint message")
    sub_cp.add_argument("-s", "--status", type=str, default="ACTIVE", choices=["ACTIVE", "COMPLETED", "BLOCKED"], help="Status state")
    sub_cp.add_argument("-n", "--namespace", type=str, default=None, help="Target namespace override")
    sub_cp.add_argument("--strict", action="store_true", help="Reject checkpoint if groundedness audit fails")
    sub_cp.add_argument("--skip-groundedness", action="store_true", help="Bypass automated groundedness audit")
    sub_cp.set_defaults(func=cmd_checkpoint)

    # groundedness
    sub_gr = subparsers.add_parser("groundedness", help="Audit code changes against CONTEXT.md invariants and DECISIONS.md ADRs (Self-RAG)", description="Audit code changes against CONTEXT.md invariants and DECISIONS.md ADRs (Self-RAG)")
    sub_gr.add_argument("-n", "--namespace", type=str, default=None, help="Target namespace override")
    sub_gr.add_argument("--strict", action="store_true", help="Exit with non-zero code on violation")
    sub_gr.set_defaults(func=cmd_groundedness)
    
    # log-warn
    sub_warn = subparsers.add_parser("log-warn", help="Append warning to Obsidian STATE.md (standard tier)")
    sub_warn.add_argument("-m", "--msg", type=str, default="Unclassified harness warning", help="Warning message")
    sub_warn.set_defaults(func=cmd_log_warn)

    # install-hook
    subparsers.add_parser("install-hook", help="Install git post-commit hook for auto Obsidian checkpoint").set_defaults(func=cmd_install_hook)
    
    # install-push-guard
    subparsers.add_parser("install-push-guard", help="Install git pre-push hook to physically block unconfirmed pushes").set_defaults(func=cmd_install_push_guard)
    
    # install-pre-commit
    subparsers.add_parser("install-pre-commit", help="Install git pre-commit anti-blunder sanitizer").set_defaults(func=cmd_install_pre_commit)
    
    # install-hooks-all
    sub_hall = subparsers.add_parser("install-hooks-all", help="Batch install hooks to all repos in ~/Projects")
    sub_hall.add_argument("-t", "--target-dir", type=str, default=None, help="Target directory (default: ~/Projects)")
    sub_hall.set_defaults(func=cmd_install_hooks_all)
    
    # set-global-git-templates
    subparsers.add_parser("set-global-git-templates", help="Configure global git templates for automatic hooks on new repos").set_defaults(func=cmd_set_global_git_templates)
    
    # scaffold-all-projects
    sub_scaf = subparsers.add_parser("scaffold-all-projects", help="Batch scaffold 4-file Obsidian memory for all projects in ~/Projects")
    sub_scaf.add_argument("-t", "--target-dir", type=str, default=None, help="Target directory (default: ~/Projects)")
    sub_scaf.set_defaults(func=cmd_scaffold_all_projects)
    
    # mcp-inspect
    subparsers.add_parser("mcp-inspect", help="Securely inspect dual-file MCP endpoints").set_defaults(func=cmd_mcp_inspect)
    
    # inspect-symbol
    sub_sym = subparsers.add_parser("inspect-symbol", help="Extract symbol using AST/brace-counter")
    sub_sym.add_argument("file", type=str, help="Path to file")
    sub_sym.add_argument("symbol", type=str, help="Symbol name (function, class)")
    sub_sym.set_defaults(func=cmd_inspect_symbol)
    
    # find
    sub_find = subparsers.add_parser("find", help="Recursively search symbol across codebase files")
    sub_find.add_argument("query", type=str, help="Symbol/function name to search")
    sub_find.set_defaults(func=cmd_find)
    
    # inspect-env
    sub_env = subparsers.add_parser("inspect-env", help="Safely inspect .env file with token masking")
    sub_env.add_argument("file", type=str, help="Path to .env file")
    sub_env.set_defaults(func=cmd_inspect_env)
    
    # audit-skills
    subparsers.add_parser("audit-skills", help="Audit skill registry count and token impact").set_defaults(func=cmd_audit_skills)
    
    # skill-load
    sub_sload = subparsers.add_parser("skill-load", help="Activate skill from archive to active registry")
    sub_sload.add_argument("name", type=str, help="Skill name")
    sub_sload.set_defaults(func=cmd_skill_load)
    
    # skill-archive
    sub_sarc = subparsers.add_parser("skill-archive", help="Move active skill to archive")
    sub_sarc.add_argument("name", type=str, help="Skill name")
    sub_sarc.set_defaults(func=cmd_skill_archive)
    
    # skill-list
    sub_slist = subparsers.add_parser("skill-list", help="List active and archived skills")
    sub_slist.add_argument("--all", action="store_true", help="Show all archived skills")
    sub_slist.set_defaults(func=cmd_skill_list)
    
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()


