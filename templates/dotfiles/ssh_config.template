# ~/.ssh/config — Standard Sovereign Multi-Forge & Server SSH Routing Template
# Copy to ~/.ssh/config and adjust hostnames and key paths as needed.

# --- Git Multi-Forge Remotes (Tri-Forge / Penta-Push) ---
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_ed25519

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host gitea.com
    HostName gitea.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host bitbucket.org
    HostName bitbucket.org
    User git
    IdentityFile ~/.ssh/id_ed25519

# --- Remote Server / VPS Example ---
# Host vps-main
#     HostName 192.0.2.1
#     User deploy
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519
#     ForwardAgent no

# --- Sovereign VPS Host (Mode B: Direct Sovereign Host) ---
# Use this when running AI agents directly on the VPS host.
# See rules/environment-topology.md for Mode B operational guardrails.
Host vps-sovereign
    HostName 192.0.2.1
    User deploy
    Port 22
    IdentityFile ~/.ssh/id_ed25519
    ForwardAgent no
    IdentitiesOnly yes

# --- Development VPS (Ephemeral Ports) ---
# Use isolated dev ports per environment-topology.md Port Collision Guard
Host vps-dev
    HostName 192.0.2.1
    User deploy
    Port 2222
    IdentityFile ~/.ssh/id_ed25519_dev
    ForwardAgent no
    IdentitiesOnly yes
