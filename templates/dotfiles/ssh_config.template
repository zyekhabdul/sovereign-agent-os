# ~/.ssh/config — Standard Sovereign Multi-Forge & Server SSH Routing Template
# Copy to ~/.ssh/config and adjust hostnames and key paths as needed.

# --- Git Multi-Forge Remotes (Tri-Forge / Penta-Push) ---
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519

Host codeberg.org
    HostName codeberg.org
    User git
    IdentityFile ~/.ssh/id_ed25519

Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519

