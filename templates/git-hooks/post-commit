#!/usr/bin/env bash
# Auto-generated by agy-guard global template (Anti-Desync RAG Synchronizer)
export PATH="$HOME/.local/bin:$PATH"

if command -v agy-guard >/dev/null 2>&1; then
    COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null | head -n 1)
    agy-guard checkpoint --msg "Auto-commit: ${COMMIT_MSG:-Updated files}" --status ACTIVE --skip-groundedness >/dev/null 2>&1
else
    # Direct POSIX fallback: Update INDEX.md and STATE.md commit hash
    GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    REPO_NAME="$(basename "$GIT_ROOT")"
    COMMIT_HASH="$(git rev-parse HEAD 2>/dev/null || echo "")"
    NOW="$(date '+%Y-%m-%d %H:%M:%S')"
    MEM_DIR="${OBSIDIAN_VAULT_PATH:-$HOME/Documents/Obsidian Vault}/00-AGY-Memory/$REPO_NAME"

    if [ -n "$COMMIT_HASH" ] && [ -d "$MEM_DIR" ]; then
        if [ -f "$MEM_DIR/INDEX.md" ]; then
            sed -i -E "s/(- \*\*(Latest )?Git Commit Hash\*\*:\s*).*/\1\`$COMMIT_HASH\`/" "$MEM_DIR/INDEX.md" 2>/dev/null || true
            sed -i -E "s/(- \*\*Last Memory Sync\*\*:\s*).*/\1$NOW/" "$MEM_DIR/INDEX.md" 2>/dev/null || true
        fi
        if [ -f "$MEM_DIR/STATE.md" ]; then
            sed -i -E "s/(- \*\*Git Commit\*\*:\s*).*/\1\`$COMMIT_HASH\`/" "$MEM_DIR/STATE.md" 2>/dev/null || true
            sed -i -E "s/(- \*\*Last Checkpoint\*\*:\s*).*/\1$NOW/" "$MEM_DIR/STATE.md" 2>/dev/null || true
        fi
    fi
fi

